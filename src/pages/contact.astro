---
import Base from '../layouts/Base.astro';
import { Picture } from 'astro:assets';
import Slot from '../components/Slot.astro';
import BuildHero from '../components/services/BuildHero.astro';
import FallHeading from '../components/services/FallHeading.astro';
import { icon } from '../lib/icons.js';
import mapImage from '../images/map-lazimpat.png';
import { site, businessTypes } from '../data/site.js';
import { needs, needAliases } from '../data/services.js';
import { PHONE_CHARS, MIN_FILL_MS } from '../../functions/api/contact.js';
import { breadcrumbList, abs } from '../lib/schema.js';

const path = '/contact';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path },
];

const facts = [
  { icon: 'chat', value: 'We reply within minutes', label: site.hoursShort },
  { icon: 'store', value: 'Lazimpat Road', label: 'Come in during opening hours' },
  { icon: 'sheet', value: 'A written proposal', label: 'Before any work begins' },
  { icon: 'coins', value: 'No cost, no obligation', label: 'For the first consultation' },
];

// What follows an enquiry, taken from the process we publish in full.
const next = [
  { icon: 'chat', title: 'We reply', body: `By phone or WhatsApp on the number you give us, ${site.replyTime} during ${site.hoursShort}.` },
  { icon: 'calendar', title: 'We consult', body: 'A conversation about how the business runs, where time is lost and what you want to achieve. By call or at your office, at no cost.' },
  { icon: 'sheet', title: 'We document', body: 'A written proposal: the problem, the solution we recommend, the scope, the timeline and the cost. Nothing begins before you approve it.' },
];

const schema = [
  {
    '@type': 'ContactPage',
    '@id': `${abs(path)}#page`,
    url: abs(path),
    name: 'Contact Nine Technology',
    about: { '@id': `${site.url}/#organization` },
  },
  breadcrumbList(crumbs),
];
---

<Base
  title="Contact Nine Technology — Lazimpat, Kathmandu"
  description={`Call ${site.phoneDisplay}, message us on WhatsApp or send the form. Lazimpat Road, Kathmandu. Open ${site.hoursShort}. We reply ${site.replyTime}.`}
  path="/contact"
  schema={schema}
>
  <BuildHero
    crumbs={crumbs}
    kicker="Contact"
    h1="Talk to us"
    sceneName="contact"
    primary={{ label: `Call ${site.phoneDisplay}`, href: site.phoneHref }}
    secondary={{ label: 'Message us on WhatsApp', href: site.whatsapp }}
    facts={facts}
  >
    Call, message on WhatsApp, or send the form below. {site.replyPromise} The first consultation carries no cost and no obligation.
  </BuildHero>

  <section class="section">
    <div class="wrap contact-grid">
      <div id="send">
        <FallHeading text="Send a message" />
        <p class="lead">Tell us what the business does and what you need. The more specific you are, the more useful our first reply will be.</p>

        <form class="form" id="contact-form" method="post" action="/api/contact" data-phone={site.phoneDisplay} data-phone-chars={PHONE_CHARS.source} data-min-ms={MIN_FILL_MS} data-need-aliases={JSON.stringify(needAliases)} novalidate>
          <div class="field-row">
            <div class="field">
              <label for="name">Your name</label>
              <input id="name" name="name" type="text" autocomplete="name" required maxlength="80" />
            </div>

            <div class="field">
              <label for="phone">Phone number<span class="hint">So we can call or WhatsApp you back.</span></label>
              <input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required maxlength="24" />
            </div>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="business">Business type</label>
              <select id="business" name="business" required>
                <option value="">Choose one</option>
                {businessTypes.map((t) => <option value={t}>{t}</option>)}
              </select>
            </div>

            <div class="field">
              <label for="need">Service<span class="hint">The closest match. "Not sure yet" is fine.</span></label>
              <select id="need" name="need">
                {needs.map((n) => <option value={n.value} selected={n.value === 'not-sure'}>{n.label}</option>)}
              </select>
            </div>
          </div>

          <div class="field">
            <label for="message">Tell us about it<span class="hint">Anything that helps: your current website, a deadline, or what you have already tried.</span></label>
            <textarea id="message" name="message" required minlength="10" maxlength="2000"></textarea>
          </div>

          {/* Left empty by people, filled in by bots. */}
          {/* Named so no browser or password manager will ever autofill it. */}
          <div class="hp" aria-hidden="true">
            <label for="extra">Leave this empty</label>
            <input id="extra" name="extra" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="ts" value="" />

          <div class="form-foot">
            <button class="btn btn-primary" type="submit">Send message</button>
            <p class="form-status" role="status" aria-live="polite"></p>
          </div>
        </form>

        <div class="form-success" id="form-success" hidden>
          <h3>Message sent</h3>
          <p>Thank you. We have your message and we will call or WhatsApp you on the number you gave, usually {site.replyTime} during {site.hoursShort}. If you sent it outside those hours, you will hear from us first thing on the next working day.</p>
          <p class="section-body">In a hurry? <a class="link" href={site.whatsapp} rel="noopener">Message us on WhatsApp</a> and we will see it sooner.</p>
        </div>
      </div>

      <div>
        <FallHeading text="Where we are" />
        <div class="visit">
        <a class="map" href={site.mapLink} rel="noopener" aria-label="Open Nine Technology’s location in Google Maps">
          <Picture src={mapImage} alt="Map showing Nine Technology on Lazimpat Road, Kathmandu" widths={[400, 800, 1200]} sizes="(min-width: 900px) 520px, 100vw" formats={['avif', 'webp']} loading="lazy" decoding="async" />
        </a>
        <p class="slot-caption">Map data © OpenStreetMap contributors. Tap the map to open directions.</p>
        {/* Appears only once office-exterior is supplied; see IMAGES.md. */}
        <Slot name="office-exterior" alt="The Nine Technology office and signboard on Lazimpat Road, Kathmandu" ratio="3-2" optional caption="Look for this signboard on Lazimpat Road." class="section-body" sizes="(min-width: 900px) 520px, 100vw" />

        <dl class="detail-list">
          <div>
            <dt>Address</dt>
            <dd>{site.address.display}</dd>
          </div>
          <div>
            <dt>Phone and WhatsApp</dt>
            <dd><a class="link" href={site.phoneHref}>{site.phoneDisplay}</a></dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd><a class="link" href={site.emailHref}>{site.email}</a></dd>
          </div>
          <div>
            <dt>Opening hours</dt>
            <dd>{site.hours}</dd>
          </div>
          <div>
            <dt>How fast we reply</dt>
            <dd>{site.replyPromise}</dd>
          </div>
          <div>
            <dt>Areas we serve</dt>
            <dd>{site.reach}</dd>
          </div>
        </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap">
      <div class="section-head">
        <FallHeading text="What happens next" />
        <p class="lead">The same three steps follow every enquiry, whether it arrives by form, phone or WhatsApp.</p>
      </div>
      <ol class="next-steps stagger reveal">
        {next.map((n, i) => (
          <li>
            <div class="next-head">
              <Fragment set:html={icon(n.icon, 48)} />
              <span class="next-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3>{n.title}</h3>
            <p>{n.body}</p>
          </li>
        ))}
      </ol>
      <p class="section-body"><a class="link" href="/how-we-work">See how we work in full</a></p>
    </div>
  </section>

  <script is:inline>
    (() => {
      const form = document.getElementById('contact-form');
      if (!form) return;
      const status = form.querySelector('.form-status');
      const success = document.getElementById('form-success');

      // Bots post instantly; people take longer than three seconds to type.
      const loadedAt = Date.now();
      form.elements.ts.value = String(loadedAt);
      const minMs = Number(form.dataset.minMs);
      const phoneChars = new RegExp(form.dataset.phoneChars);

      // Service pages link here with ?need=..., so the right service is
      // already chosen. Old links (?need=portfolio) map to their new values.
      const aliases = JSON.parse(form.dataset.needAliases);
      let need = new URLSearchParams(location.search).get('need');
      need = aliases[need] || need;
      if (need && [...form.elements.need.options].some((o) => o.value === need)) {
        form.elements.need.value = need;
      }

      const setError = (field, msg) => {
        const wrap = field.closest('.field');
        let el = wrap.querySelector('.error');
        if (!msg) {
          field.removeAttribute('aria-invalid');
          field.removeAttribute('aria-describedby');
          el?.remove();
          return false;
        }
        field.setAttribute('aria-invalid', 'true');
        if (!el) {
          el = document.createElement('span');
          el.className = 'error';
          el.id = field.id + '-error';
          wrap.appendChild(el);
        }
        el.textContent = msg;
        field.setAttribute('aria-describedby', el.id);
        return true;
      };

      const check = (field) => {
        const v = field.value.trim();
        if (field.name === 'name') return setError(field, v.length < 2 ? 'Please tell us your name.' : '');
        if (field.name === 'phone') {
          const digits = v.replace(/\D/g, '').length;
          if (digits < 7 || digits > 15) return setError(field, 'Please give a phone number we can reach you on.');
          return setError(field, phoneChars.test(v) ? '' : 'Please use only digits, spaces, + ( ) and -.');
        }
        if (field.name === 'business') return setError(field, v ? '' : 'Please choose the closest match.');
        if (field.name === 'message') return setError(field, v.length < 10 ? 'A sentence or two is enough.' : '');
        return false;
      };

      for (const f of ['name', 'phone', 'business', 'message']) {
        form.elements[f].addEventListener('blur', () => check(form.elements[f]));
      }

      const button = form.querySelector('button[type=submit]');
      const fail = (message) => {
        button.disabled = false;
        status.dataset.state = 'error';
        status.textContent = message ||
          'That did not send. Please call or WhatsApp us on ' + form.dataset.phone + ' instead, or try again in a moment.';
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        let bad = null;
        for (const f of ['name', 'phone', 'business', 'message']) {
          if (check(form.elements[f]) && !bad) bad = form.elements[f];
        }
        if (bad) { bad.focus(); status.dataset.state = 'error'; status.textContent = 'Please fix the fields marked above.'; return; }

        button.disabled = true;
        status.dataset.state = '';
        status.textContent = 'Sending…';

        // Someone using autofill can finish in under three seconds. Wait out
        // the remainder rather than have the server reject a real person.
        const wait = minMs - (Date.now() - loadedAt);
        if (wait > 0) await new Promise((r) => setTimeout(r, wait + 100));

        try {
          const res = await fetch(form.action, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(Object.fromEntries(new FormData(form))),
          });
          const data = await res.json().catch(() => ({}));
          if (res.ok && data.ok) {
            form.hidden = true;
            success.hidden = false;
            success.setAttribute('tabindex', '-1');
            success.focus();
            return;
          }
          // The server says exactly what went wrong; show that, not a guess.
          for (const f of data.fields || []) {
            if (form.elements[f]) setError(form.elements[f], 'Please check this field.');
          }
          fail(data.message);
        } catch {
          fail();
        }
      });
    })();
  </script>
</Base>
