---
/**
 * About. In order: who we are (hero), where the name comes from, the two
 * people you will actually deal with, how we work, what we commit to in
 * writing, and the company's own details.
 *
 * The six steps are the shared compact component, not a third copy of them:
 * Home and the Services hub render the same one, and /how-we-work holds the
 * full version.
 */
import Base from '../layouts/Base.astro';
import Slot from '../components/Slot.astro';
import BuildHero from '../components/services/BuildHero.astro';
import FallHeading from '../components/services/FallHeading.astro';
import HowWeWork from '../components/HowWeWork.astro';
import CtaStrip from '../components/services/CtaStrip.astro';
import { icon } from '../lib/icons.js';
import { site, people, commitments } from '../data/site.js';
import { breadcrumbList, abs } from '../lib/schema.js';

const path = '/about';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'About', path },
];
const consult = { label: 'Request a consultation', href: '/contact' };
const initials = (name) => name.split(' ').map((w) => w[0]).join('');

const facts = [
  { icon: 'users', value: 'Two directors', label: 'You deal with one of them directly' },
  { icon: 'store', value: 'Lazimpat, Kathmandu', label: 'An office you can visit' },
  { icon: 'calendar', value: `Founded ${site.founded}`, label: site.legalName },
  { icon: 'lock', value: 'Registered in your name', label: 'Domain, hosting, logins, code' },
];

const schema = [
  ...people.map((p) => ({
    '@type': 'Person',
    name: p.name,
    jobTitle: p.title,
    worksFor: { '@id': `${site.url}/#organization` },
  })),
  {
    '@type': 'AboutPage',
    '@id': `${abs(path)}#page`,
    url: abs(path),
    name: 'About Nine Technology',
    about: { '@id': `${site.url}/#organization` },
  },
  breadcrumbList(crumbs),
];
---

<Base
  title="About Nine Technology — IT Company in Lazimpat, Kathmandu"
  description="Nine Technology is an IT company on Lazimpat Road, Kathmandu, founded in 2026. Meet the two directors and see how we scope, build and support projects."
  path={path}
  schema={schema}
>
  <BuildHero
    crumbs={crumbs}
    kicker="About"
    h1="An IT company in Lazimpat, built to stay"
    sceneName="company"
    primary={consult}
    secondary={{ label: 'See our work', href: '/work' }}
    facts={facts}
  >
    Nine Technology builds websites, software and AI automation for businesses in Kathmandu, and then keeps them running. We were founded in {site.founded} because most businesses here are still running on paper and WhatsApp, and the companies that built their websites stopped answering the phone.
  </BuildHero>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <FallHeading text="Why “Nine”" />
      </div>
      <div class="nava">
        <div class="nine" aria-hidden="true">
          <span></span><span></span><span></span>
          <span></span><span></span><span></span>
          <span></span><span></span><span></span>
        </div>
        <div class="prose">
          <p>In Sanskrit, <i lang="sa">nava</i> means <i>nine</i>. In Nepali, <i lang="ne">nava</i> means <i>new</i>. Nine is completion — the last number before a new cycle begins.</p>
          <p>In Nepal it is Navadurga, and the nine nights of Dashain. Rooted in the old, built for the new, and finished properly.</p>
          <p>That is also why the full stop in our logo is a solid square. A job is either finished or it is not.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap">
      <div class="section-head">
        <FallHeading text="The directors" />
        <p class="lead">{site.legalName} is owned and run by its two directors. Every project is scoped with one of them, delivered by our team, and remains their responsibility through to the support that follows launch.</p>
      </div>
      <ul class="people">
        {people.map((p) => (
          <li class="person">
            <div class="person-photo">
              <Slot name={p.slot} alt={`${p.name}, ${p.title} at Nine Technology`} ratio="1-1" sizes="160px" optional />
              <span class="person-monogram" aria-hidden="true">{initials(p.name)}</span>
            </div>
            <div class="person-copy">
              <h3>{p.name}</h3>
              <p class="title">{p.title}</p>
              {p.role && <p class="person-role">{p.role}</p>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <HowWeWork />

  <section class="section section-tint">
    <div class="wrap">
      <div class="section-head">
        <FallHeading text="What we commit to" />
        <p class="lead">These four are in every contract we write, not just on this page.</p>
      </div>
      <ol class="commitments cards stagger reveal">
        {commitments.map((c, i) => (
          <li class="commitment">
            <div class="commitment-head">
              <Fragment set:html={icon(c.icon, 44)} />
              <span class="commitment-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <FallHeading text="The company" />
        <p class="lead">Registered, addressed and reachable. If you would rather talk in person, the office is on Lazimpat Road and you are welcome to come in.</p>
      </div>
      <dl class="company-facts">
        <div><dt>Registered name</dt><dd>{site.legalName}</dd></div>
        <div><dt>Address</dt><dd>{site.address.display}</dd></div>
        <div><dt>Founded</dt><dd>{site.founded}</dd></div>
        <div><dt>Areas served</dt><dd>{site.areasServed.join(', ')} and the rest of Nepal</dd></div>
      </dl>
      <div class="office-pair">
        <Slot name="office-exterior" alt="The Nine Technology office on Lazimpat Road, Kathmandu" ratio="3-2" sizes="(min-width: 900px) 440px, 100vw" caption="Our office on Lazimpat Road" />
        <Slot name="office-interior" alt="Inside the Nine Technology office, Lazimpat, Kathmandu" ratio="3-2" sizes="(min-width: 900px) 440px, 100vw" caption="Where the work is done" />
      </div>
    </div>
  </section>

  <CtaStrip
    heading="Tell us about your project"
    body="Describe what you need to build or improve. The first consultation carries no cost and no obligation, and you will have a written proposal before any work begins."
    primary={consult}
  />
</Base>
