---
/**
 * Work. One case study per project, published only once the client has given
 * written permission. Each describes what exists and can be checked on the live
 * site; no outcome is claimed unless the client confirmed the number.
 *
 * While `projects` is empty the page renders the honest empty state rather than
 * inventing work, so it is safe to ship at any point.
 */
import Base from '../layouts/Base.astro';
import Slot from '../components/Slot.astro';
import BuildHero from '../components/services/BuildHero.astro';
import FallHeading from '../components/services/FallHeading.astro';
import CtaStrip from '../components/services/CtaStrip.astro';
import { icon } from '../lib/icons.js';
import { site } from '../data/site.js';
import { projects } from '../data/projects.js';
import { breadcrumbList, abs, orgRef } from '../lib/schema.js';

const path = '/work';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Work', path },
];
const consult = { label: 'Request a consultation', href: '/contact' };

const facts = [
  { icon: 'launch', value: 'Live sites', label: 'Open them and judge for yourself' },
  { icon: 'lock', value: 'Shown with permission', label: 'Named only when the client agrees' },
  { icon: 'software', value: 'Run by the client', label: 'Each one has its own admin' },
  { icon: 'search', value: 'Built to be found', label: 'Marked up for local search' },
];

// What a consultation covers, in the order we would actually go through it.
const showYou = [
  { icon: 'website', text: 'The live site or system opened on a phone, so you can see how it loads on mobile data rather than on office wifi.' },
  { icon: 'software', text: 'The admin side: the part you would use every day to change prices, add people or answer enquiries.' },
  { icon: 'coins', text: 'What it cost, how long it took, and what changed for the business afterwards.' },
];

const schema = [
  ...(projects.length
    ? [{
        '@type': 'ItemList',
        '@id': `${abs(path)}#work`,
        name: `Work delivered by ${site.name}`,
        itemListElement: projects.map((p, n) => ({
          '@type': 'ListItem',
          position: n + 1,
          item: {
            '@type': 'WebSite',
            name: p.client,
            url: p.url,
            description: p.summary,
            creator: orgRef,
          },
        })),
      }]
    : []),
  breadcrumbList(crumbs),
];
---

<Base
  title="Our Work — Nine Technology"
  description="Projects we have delivered for businesses in Kathmandu, published with the client's written permission. Open the live sites and judge the work yourself."
  path={path}
  schema={schema}
>
  <BuildHero
    crumbs={crumbs}
    kicker="Work"
    h1="Our work"
    sceneName="work"
    primary={consult}
    secondary={{ label: 'All services', href: '/services' }}
    facts={facts}
  >
    A project appears here only once the client has given written permission to be named and shown. Every site linked below is live, so you can open it, load it on your own phone and judge the work rather than take our word for it.
  </BuildHero>

  {projects.length === 0 ? (
    <section class="section">
      <div class="wrap narrow">
        <p class="lead">The first projects are being documented here. Ask us and we will take you through the work directly: the live sites, the systems behind them, and what each one changed for the business.</p>
        <div class="btn-row section-body">
          <a class="btn btn-primary" href={consult.href}>{consult.label}</a>
          <a class="btn btn-secondary" href={site.whatsapp} rel="noopener">Message us on WhatsApp</a>
        </div>
      </div>
    </section>
  ) : (
    <section class="section">
      <div class="wrap">
        {projects.map((p, i) => (
          <article class="case reveal" id={p.slug}>
            <figure class="case-shot">
              <Slot name={p.image} alt={`The ${p.client} website, built by ${site.name}`} ratio="3-2" priority={i === 0} sizes="(min-width: 1000px) 56vw, 100vw" />
              <figcaption>{p.url.replace('https://', '')}</figcaption>
            </figure>
            <div class="case-copy">
              <p class="case-meta">
                <a href={p.sectorHref}>{p.sector}</a>
                <span class="case-dot" aria-hidden="true">·</span>
                <span class="case-where">{p.location}</span>
              </p>
              <h2>{p.client}</h2>
              <p class="case-summary">{p.summary}</p>

              <ul class="case-built">
                {p.built.map((b) => <li><strong>{b.lead}.</strong> {b.text}</li>)}
              </ul>

              <div class="case-foot">
                <a class="btn btn-secondary" href={p.url} target="_blank" rel="noopener">Open the live site</a>
                <ul class="chips case-chips">
                  {p.services.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
                </ul>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="section section-tint">
    <div class="wrap">
      <div class="section-head">
        <FallHeading text="What we would show you" />
        <p class="lead">More than fits on a page. Ask, and we will take you through it on a call or in person.</p>
      </div>
      <ul class="show-you stagger reveal">
        {showYou.map((item) => (
          <li>
            <Fragment set:html={icon(item.icon, 52)} />
            <p>{item.text}</p>
          </li>
        ))}
      </ul>
      <p class="section-body"><a class="link" href="/services">See what we do</a></p>
    </div>
  </section>

  <CtaStrip
    heading="Tell us about your project"
    body="Describe what you need to build or improve. The first consultation carries no cost and no obligation, and you will have a written proposal before any work begins."
    primary={consult}
  />
</Base>
