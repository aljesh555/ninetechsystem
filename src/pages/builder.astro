    <script>
      import { initialState, price, included, betterPlan, npr } from '../lib/package-price.js';
      import { units, websites, levels, discounts, planWebsiteDiscount, planSeoDiscount } from '../data/packages.js';

      const WA = '9779843325804';
      const STAFF = new URLSearchParams(location.search).has('staff');
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const $ = (s, r = document) => r.querySelector(s);
      const $$ = (s, r = document) => [...r.querySelectorAll(s)];
      const rs = (n) => `Rs ${npr(n)}`;

      // ---- the conversation -------------------------------------------------
      const SECTIONS = { website: 'Website', app: 'App', marketing: 'Marketing', search: 'Search & AI', extras: 'Extras', review: 'Review' };
      const hasApp = (s) => s.app.ios || s.app.android;
      const inMkt = (s) => s.mkt === true;
      const WHEN = {
        'web-pages': (s) => s.web.type !== 'none',
        'web-lang': (s) => s.web.type === 'landing',
        'app-tier': hasApp,
        'app-care': hasApp,
        platforms: inMkt, graphics: inMkt, reels: inMkt, filming: inMkt, photos: inMkt, ads: inMkt, boosts: inMkt,
        creators: (s) => inMkt(s) && s.qty.halfDays > 0,
      };
      const STEPS = $$('.wiz-step').map((el) => el.dataset.step);
      const visibleSteps = () => STEPS.filter((id) => (WHEN[id] ? WHEN[id](state) : true));
      const secOf = (id) => $(`.wiz-step[data-step="${id}"]`).dataset.sec;

      // ---- state, kept in the URL hash --------------------------------------
      const enc = (o) => {
        const bytes = new TextEncoder().encode(JSON.stringify(o));
        return btoa(String.fromCharCode(...bytes)).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
      };
      const dec = (s) => {
        const bin = atob(s.replace(/-/g, '+').replace(/_/g, '/'));
        return JSON.parse(new TextDecoder().decode(Uint8Array.from(bin, (c) => c.charCodeAt(0))));
      };
      const blank = () => ({ ...initialState(null), mkt: null, ui: { screen: 'start', step: STEPS[0], from: 'start' } });
      let state = blank();
      try {
        const m = location.hash.match(/q=([\w-]+)/);
        if (m) {
          const saved = dec(m[1]);
          const base = blank();
          state = {
            ...base, ...saved,
            qty: { ...base.qty, ...saved.qty }, web: { ...base.web, ...saved.web },
            app: { ...base.app, ...saved.app }, ui: { ...base.ui, ...saved.ui },
          };
        }
      } catch { state = blank(); }
      const save = () => history.replaceState(null, '', `${location.search}#q=${enc(state)}`);

      const get = (path) => path.split('.').reduce((o, k) => o[k], state);
      const set = (path, v) => {
        const ks = path.split('.');
        const last = ks.pop();
        ks.reduce((o, k) => o[k], state)[last] = v;
      };
      const parse = (v) => (v === 'true' ? true : v === 'false' ? false : /^\d+$/.test(v) ? Number(v) : v);

      function bounds(path, el) {
        let min = Number(el.dataset.min);
        let max = Number(el.dataset.max);
        const inc = included(state);
        if (path.startsWith('qty.')) min = inc[path.slice(4)];
        if (path === 'web.pages') {
          const w = websites[state.web.type];
          if (w) { min = w.minPages ?? 1; max = w.maxPages; }
        }
        return { min, max, step: Number(el.dataset.step) || 1 };
      }

      function choosePlan(id) {
        if (!id) { state.plan = null; return; }
        const next = initialState(id);
        for (const k of Object.keys(state)) if (!['plan', 'qty', 'platforms', 'seo', 'ai', 'care'].includes(k)) next[k] = state[k];
        // Keep anything already asked for above the new plan's allowance.
        for (const k of Object.keys(units)) next.qty[k] = Math.max(next.qty[k], state.plan ? next.qty[k] : state.qty[k]);
        if (!state.plan) {
          next.platforms = [...new Set([...next.platforms, ...state.platforms])];
          for (const k of ['seo', 'ai', 'care']) next[k] = Math.max(next[k], state[k]);
        }
        next.mkt = true;
        state = next;
      }

      const ACTS = {
        custom() {
          state.plan = null;
          state.ui.step = STEPS[0];
          show('wizard');
        },
        'app:none'() { state.app.ios = false; state.app.android = false; },
        'app:ios'() { state.app.ios = true; state.app.android = false; },
        'app:android'() { state.app.ios = false; state.app.android = true; },
        'app:both'() { state.app.ios = true; state.app.android = true; },
        'mkt:yes'() {
          state.mkt = true;
          if (!state.platforms.length) state.platforms = ['facebook', 'instagram'];
          if (!state.qty.graphics) state.qty.graphics = 8;
        },
        'mkt:no'() {
          state.mkt = false;
          if (!state.plan) { for (const k of Object.keys(units)) state.qty[k] = 0; state.platforms = []; }
        },
      };
      const actOn = (a) => ({
        'app:none': !hasApp(state), 'app:ios': state.app.ios && !state.app.android,
        'app:android': state.app.android && !state.app.ios, 'app:both': state.app.ios && state.app.android,
        'mkt:yes': state.mkt === true, 'mkt:no': state.mkt === false,
      })[a];

      // ---- screens and steps --------------------------------------------------
      function show(screen) {
        if (screen === 'review' && !['proposal', 'review'].includes(state.ui.screen)) state.ui.from = state.ui.screen;
        state.ui.screen = screen;
        $('[data-cart]').classList.remove('is-open');
        commit();
        scrollTo({ top: 0, behavior: 'instant' });
      }

      let dir = 1;
      function goStep(id, d = 1) {
        dir = d;
        state.ui.step = id;
        commit();
        if ($('.wiz').getBoundingClientRect().top < 0) scrollTo({ top: 0, behavior: reduce ? 'instant' : 'smooth' });
      }
      function next() {
        const list = visibleSteps();
        const i = list.indexOf(state.ui.step);
        if (i < 0 || i === list.length - 1) return show('review');
        goStep(list[i + 1], 1);
      }
      function back() {
        const list = visibleSteps();
        const i = list.indexOf(state.ui.step);
        if (i <= 0) return show('start');
        goStep(list[i - 1], -1);
      }

      // ---- events -------------------------------------------------------------
      let advancing = null;
      document.addEventListener('click', (e) => {
        const t = e.target.closest('button, a');
        if (!t) return;
        const d = t.dataset;

        if (d.act) {
          ACTS[d.act]?.();
          if (d.act !== 'custom') commit();
        } else if (d.toggle) {
          const off = parse(d.off);
          set(d.toggle, get(d.toggle) === off ? parse(d.on) : off);
          commit();
        } else if (d.plan !== undefined) {
          choosePlan(d.plan);
          if (t.hasAttribute('data-plan-go')) return show('review');
          commit();
          // On the plans screen the package stays put and the website and search
          // options below become its own, so bring them into view.
          if (state.ui.screen === 'plans' && d.plan) {
            $('[data-plan-extras]')?.scrollIntoView({ behavior: reduce ? 'instant' : 'smooth', block: 'start' });
          }
        } else if (d.path) {
          const path = d.path;
          let v = parse(d.v);
          if (['seo', 'ai', 'care'].includes(path)) v = Math.max(v, included(state)[path]);
          set(path, v);
          if (path === 'web.type' && websites[v]) {
            const w = websites[v];
            state.web.pages = Math.min(Math.max(state.web.pages, w.minPages ?? 1), w.maxPages);
          }
          commit();
        } else if (d.set) {
          const v = d.v;
          if (included(state).platforms.includes(v)) return;
          const list = state[d.set];
          state[d.set] = list.includes(v) ? list.filter((x) => x !== v) : [...list, v];
          commit();
        } else if (t.hasAttribute('data-inc') || t.hasAttribute('data-dec')) {
          const stepper = t.closest('[data-stepper]');
          const path = stepper.dataset.stepper;
          const { min, max, step } = bounds(path, stepper);
          set(path, Math.min(max, Math.max(min, get(path) + (t.hasAttribute('data-inc') ? step : -step))));
          commit();
        } else if (d.go) {
          return show(d.go);
        } else if (d.jump) {
          if (d.jump === 'review') return show('review');
          const first = visibleSteps().find((id) => secOf(id) === d.jump);
          if (first) goStep(first, STEPS.indexOf(first) >= STEPS.indexOf(state.ui.step) ? 1 : -1);
          return;
        } else if (t.hasAttribute('data-next')) {
          return next();
        } else if (t.hasAttribute('data-back')) {
          return back();
        } else if (t.hasAttribute('data-back-review')) {
          const from = state.ui.from;
          return show(from === 'wizard' || from === 'plans' ? from : 'start');
        } else if (t.hasAttribute('data-cart-cta')) {
          return show(state.ui.screen === 'review' ? 'proposal' : 'review');
        } else if (t.hasAttribute('data-nudge-go')) {
          choosePlan(d.target);
          commit();
        } else if (t.hasAttribute('data-reset')) {
          const staff = state.staff;
          state = { ...blank(), staff };
          $$('[data-text]').forEach((i) => (i.value = state[i.dataset.text] ?? ''));
          return show('start');
        } else if (t.hasAttribute('data-print')) {
          return window.print();
        } else if (t.hasAttribute('data-copy')) {
          navigator.clipboard?.writeText(location.href).then(() => toast('Link copied. It opens this proposal.'));
          return;
        } else if (t.hasAttribute('data-cart-toggle')) {
          const open = $('[data-cart]').classList.toggle('is-open');
          t.setAttribute('aria-expanded', String(open));
          return;
        }

        // An answer in the conversation moves on by itself, after a beat.
        if (t.hasAttribute('data-advance') && state.ui.screen === 'wizard') {
          clearTimeout(advancing);
          advancing = setTimeout(next, reduce ? 0 : 340);
        }
      });

      document.addEventListener('keydown', (e) => {
        if (state.ui.screen !== 'wizard' || e.target.closest('input, textarea') || e.metaKey || e.ctrlKey || e.altKey) return;
        const step = $(`.wiz-step[data-step="${state.ui.step}"]`);
        if (e.key === 'Enter' && !e.target.closest('button')) { e.preventDefault(); next(); }
        else if (/^[1-9]$/.test(e.key)) $$('.opt', step)[Number(e.key) - 1]?.click();
      });

      for (const input of $$('[data-text]')) {
        input.value = state[input.dataset.text] ?? '';
        input.addEventListener('input', () => { state[input.dataset.text] = input.value; commit(); });
        input.addEventListener('keydown', (e) => { if (e.key === 'Enter' && input.dataset.text === 'client') show('proposal'); });
      }
      for (const el of $$('[data-staff-only]')) el.hidden = !STAFF;

      // ---- motion helpers ----------------------------------------------------
      const shown = new WeakMap();
      function tween(el, to) {
        const from = shown.get(el) ?? to;
        shown.set(el, to);
        if (reduce || from === to) { el.textContent = rs(to); return; }
        const t0 = performance.now();
        const step = (now) => {
          if (shown.get(el) !== to) return;
          const p = Math.min(1, (now - t0) / 520);
          el.textContent = rs(from + (to - from) * (1 - Math.pow(1 - p, 4)));
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      }
      // Bars use the Web Animations API: the CSP allows no inline styles.
      const scaleAt = new WeakMap();
      function scaleX(el, to) {
        const from = scaleAt.get(el) ?? 0;
        if (from === to) return;
        scaleAt.set(el, to);
        el.animate([{ transform: `scaleX(${from})` }, { transform: `scaleX(${to})` }], {
          duration: reduce ? 0 : 600, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'forwards',
        });
      }
      let toastTimer;
      function toast(msg) {
        const el = $('[data-toast]');
        el.textContent = msg;
        el.classList.remove('is-on');
        void el.offsetWidth;
        el.classList.add('is-on');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => el.classList.remove('is-on'), 2600);
      }

      // ---- render ------------------------------------------------------------
      let prevKeys = null;
      const prevRate = { m: null, o: null };
      let prevStep = null;

      function lineEl(l, isNew) {
        const li = document.createElement('li');
        li.className = 'line' + (isNew ? ' is-new' : '') + (l.credit ? ' is-credit' : '') + (l.plan ? ' is-plan' : '');
        const a = document.createElement('div');
        const name = document.createElement('span');
        name.className = 'line-name';
        name.textContent = l.label;
        a.append(name);
        if (l.detail) {
          const dd = document.createElement('span');
          dd.className = 'line-detail';
          dd.textContent = l.detail;
          a.append(dd);
        }
        const amt = document.createElement('span');
        amt.className = 'line-amt';
        if (l.was) {
          const s = document.createElement('s');
          s.textContent = rs(l.was);
          const now = l.amount === 0 ? 'Waived' : (l.from ? 'from ' : '') + rs(l.amount);
          amt.append(s, document.createElement('br'), now);
        } else {
          amt.textContent = (l.amount < 0 ? '− ' : '') + (l.from ? 'from ' : '') + rs(Math.abs(l.amount));
        }
        li.append(a, amt);
        return li;
      }

      function sums(dl, rows) {
        dl.replaceChildren();
        for (const [k, v, cls] of rows) {
          const dt = document.createElement('dt');
          const dd = document.createElement('dd');
          dt.textContent = k;
          dd.textContent = v;
          if (cls) { dt.className = cls; dd.className = cls; }
          dl.append(dt, dd);
        }
      }

      function discount(which, r, table, per) {
        const box = $(`[data-disc="${which}"]`);
        const text = $(`[data-disc-text="${which}"]`);
        const fill = $(`[data-meter="${which}"]`);
        const rate = r.tier?.rate ?? 0;
        // Measured on what counts towards the discount: with a plan, its extras.
        box.hidden = !r.base;
        if (!r.base) { prevRate[which] = 0; return; }
        if (r.next) {
          const b = document.createElement('strong');
          b.textContent = rs(r.next.min - r.base);
          text.replaceChildren('Add ', b, ` more${per} to unlock ${Math.round(r.next.rate * 100)}% off`);
          scaleX(fill, Math.min(1, r.base / r.next.min));
        } else {
          text.textContent = `${Math.round(table[0].rate * 100)}% off unlocked, the highest tier`;
          scaleX(fill, 1);
        }
        box.classList.toggle('is-max', !r.next);
        if (prevRate[which] !== null && rate > prevRate[which]) {
          box.classList.remove('is-pop');
          void box.offsetWidth;
          box.classList.add('is-pop');
          toast(`${Math.round(rate * 100)}% off ${which === 'm' ? (state.plan ? 'your monthly extras' : 'the monthly fee') : 'one-time work'}, unlocked`);
        }
        prevRate[which] = rate;
      }

      function renderScreens() {
        const scr = state.ui.screen;
        for (const el of $$('[data-screen]')) el.hidden = el.dataset.screen !== scr;
        $('[data-app]').hidden = !['plans', 'wizard', 'review'].includes(scr);
        document.body.className = `bld scr-${scr}`;
        $('.bld-top').hidden = scr === 'proposal';
        $('[data-reset]').hidden = scr === 'start';
      }

      function renderWizard() {
        const list = visibleSteps();
        if (!list.includes(state.ui.step)) state.ui.step = list.find((id) => STEPS.indexOf(id) > STEPS.indexOf(state.ui.step)) ?? list[0];
        const id = state.ui.step;
        for (const el of $$('.wiz-step')) el.hidden = el.dataset.step !== id;
        const cur = $(`.wiz-step[data-step="${id}"]`);
        if (prevStep !== id && state.ui.screen === 'wizard') {
          cur.classList.remove('is-in', 'is-back');
          void cur.offsetWidth;
          cur.classList.add('is-in');
          if (dir < 0) cur.classList.add('is-back');
          prevStep = id;
        }
        const i = list.indexOf(id);
        const sec = cur.dataset.sec;
        $('[data-sec-name]').textContent = SECTIONS[sec];
        $('[data-count]').textContent = `Question ${i + 1} of ${list.length}`;
        $('[data-next]').firstChild.textContent = i === list.length - 1 ? 'See my package ' : 'Next ';
        const order = Object.keys(SECTIONS);
        const at = order.indexOf(sec);
        for (const b of $$('[data-jump]')) {
          const k = order.indexOf(b.dataset.jump);
          b.classList.toggle('is-done', k < at);
          b.classList.toggle('is-cur', k === at);
          if (k === at) b.setAttribute('aria-current', 'step'); else b.removeAttribute('aria-current');
          b.disabled = b.dataset.jump !== 'review' && !list.some((s) => secOf(s) === b.dataset.jump);
        }
        if (state.ui.screen === 'wizard') scaleX($('[data-prog]'), (i + 1) / (list.length + 1));
      }

      function render() {
        renderScreens();
        renderWizard();
        const r = price(state);
        const inc = included(state);
        const plan = r.plan;

        for (const b of $$('[data-plan]')) b.setAttribute('aria-pressed', String((b.dataset.plan || null) === state.plan));
        for (const b of $$('[data-path]')) {
          b.setAttribute('aria-pressed', String(get(b.dataset.path) === parse(b.dataset.v)));
          if (['seo', 'ai', 'care'].includes(b.dataset.path)) {
            const lv = Number(b.dataset.v);
            b.disabled = !!plan && lv < inc[b.dataset.path];
            b.classList.toggle('is-inc', !!plan && lv <= inc[b.dataset.path] && lv > 0);
          }
        }
        for (const b of $$('[data-toggle]')) b.setAttribute('aria-pressed', String(get(b.dataset.toggle) !== parse(b.dataset.off)));
        for (const b of $$('[data-act]')) {
          const on = actOn(b.dataset.act);
          if (on !== undefined) b.setAttribute('aria-pressed', String(on));
        }
        for (const b of $$('[data-set]')) {
          b.setAttribute('aria-pressed', String(state.platforms.includes(b.dataset.v)));
          b.classList.toggle('is-inc', inc.platforms.includes(b.dataset.v));
        }
        for (const s of $$('[data-stepper]')) {
          const path = s.dataset.stepper;
          const { min, max } = bounds(path, s);
          const v = get(path);
          $('[data-out]', s).textContent = String(v);
          $('[data-dec]', s).disabled = v <= min;
          $('[data-inc]', s).disabled = v >= max;
        }

        // cost beside each question
        const byKey = Object.fromEntries([...r.monthly, ...r.once].map((l) => [l.key, l]));
        for (const c of $$('[data-cost]')) {
          const k = c.dataset.cost;
          let text = '';
          let quiet = false;
          if (k.startsWith('u-')) {
            const u = k.slice(2);
            const l = byKey[k];
            if (l) text = `+ ${rs(l.amount)} a month`;
            if (plan && inc[u] > 0) { text = `${inc[u]} included in ${plan.name}` + (l ? ` · + ${rs(l.amount)} a month` : ''); quiet = !l; }
          } else if (k === 'platforms') {
            const n = r.monthly.filter((l) => l.key.startsWith('pf-') || l.key === 'social').reduce((a, l) => a + l.amount, 0);
            text = n ? `+ ${rs(n)} a month for management` : plan ? `Included in ${plan.name}` : '';
            quiet = !n && !!plan;
          } else if (['seo', 'ai', 'care'].includes(k)) {
            const l = byKey[`l-${k}`];
            if (l) text = `+ ${rs(l.amount)} a month${l.was ? ` · ${Math.round(planSeoDiscount * 100)}% off with ${plan.name}` : ''}`;
            else if (plan && inc[k] > 0) { text = `Included in ${plan.name}`; quiet = true; }
          } else if (k === 'web') {
            const l = byKey.web;
            text = l ? `${l.from ? 'from ' : ''}${rs(l.amount)}${l.was ? ` · ${Math.round(planWebsiteDiscount * 100)}% off with ${plan.name}` : ''}${byKey['web-credit'] ? ` · ${rs(-byKey['web-credit'].amount)} included with 12 months` : ''}` : '';
          } else if (k === 'web-pages') {
            const w = websites[state.web.type];
            if (w) text = `${w.pages} included · ${rs(w.extraPage)} each after`;
            quiet = true;
          } else if (k === 'web-bilingual') {
            text = state.web.bilingual ? `+ ${rs(websites.landing.bilingual)}` : '';
          } else if (k === 'app') {
            text = byKey.app ? `from ${rs(byKey.app.amount)}` : '';
          } else if (k === 'app-care') {
            text = byKey['app-care'] ? `+ ${rs(byKey['app-care'].amount)} a month` : '';
          } else if (k === 'agentic') {
            text = byKey.agentic ? `from ${rs(byKey.agentic.amount)} + ${rs(byKey['agentic-care'].amount)} a month` : '';
          } else {
            text = byKey[k] ? rs(byKey[k].amount) : '';
          }
          c.textContent = text;
          c.classList.toggle('is-inc', quiet);
        }

        for (const w of $$('[data-when]')) {
          const k = w.dataset.when;
          w.hidden = !(k === 'web' ? state.web.type !== 'none' : k === 'landing' ? state.web.type === 'landing' : k === 'app' ? hasApp(state) : true);
        }

        // Website cards: with a plan, show the bundled price, original struck through.
        const webPct = Math.round(planWebsiteDiscount * 100);
        const webBundled = !!plan && !(plan.freeWebsite && state.term === 12);
        for (const el of $$('[data-web-price]')) {
          const w = websites[el.dataset.webPrice];
          const prefix = w.from ? 'From ' : '';
          if (webBundled) {
            const s = document.createElement('s');
            s.textContent = rs(w.base);
            const now = document.createElement('span');
            now.className = 'card-price-now';
            now.textContent = prefix + rs(Math.round(w.base * (1 - planWebsiteDiscount)));
            el.replaceChildren(s, ' ', now);
          } else {
            el.textContent = prefix + rs(w.base);
          }
        }

        // Search tiers: with a plan, the tier or the upgrade at its bundled
        // price; a tier the plan already covers says so.
        const seoPct = Math.round(planSeoDiscount * 100);
        const seoOpts = levels.seo.options;
        for (const el of $$('[data-seo-price]')) {
          const lv = Number(el.dataset.seoPrice);
          if (plan && lv <= inc.seo) {
            el.textContent = `Included in ${plan.name}`;
          } else if (plan) {
            const full = seoOpts[lv].price - seoOpts[inc.seo].price;
            const was = document.createElement('s');
            was.textContent = rs(full);
            const now = document.createElement('span');
            now.className = 'card-price-now';
            now.textContent = `${inc.seo ? '+ ' : ''}${rs(Math.round(full * (1 - planSeoDiscount)))} a month`;
            el.replaceChildren(was, ' ', now);
          } else {
            el.textContent = `${rs(seoOpts[lv].price)} a month`;
          }
        }

        // plans screen: the chosen package, and what has been added into it
        for (const el of $$('[data-plan-pick]')) {
          const id = el.closest('[data-plan]')?.dataset.plan;
          el.textContent = id && id === state.plan ? 'Selected ✓' : `Choose ${el.dataset.planPick} →`;
        }
        const webLine = byKey.web;
        const seoLine = byKey['l-seo'];
        for (const el of $$('[data-plan-added]')) {
          const id = el.closest('[data-plan]')?.dataset.plan;
          const bits = id && id === state.plan
            ? [webLine && webLine.label, seoLine && seoLine.label.replace(/^.*?: /, '')].filter(Boolean)
            : [];
          el.textContent = bits.length ? `Added: ${bits.join(' · ')}` : '';
          el.hidden = !bits.length;
        }
        $('[data-extras-note]').textContent = plan
          ? `A website is ${webPct}% off inside ${plan.name}. Pick one and the total below updates.`
          : `Choose a package in step 1 first. A website then costs ${webPct}% less inside it.`;
        $('[data-seo-note]').textContent = !plan
          ? `Choose a package in step 1 first. Search then costs ${seoPct}% less inside it.`
          : inc.seo
            ? `${plan.name} already includes ${seoOpts[inc.seo].name}. A higher tier is ${seoPct}% off the difference.`
            : `Search and AI visibility is ${seoPct}% off inside ${plan.name}.`;

        // review: the plan block, or a nudge towards one
        $('[data-review-plan]').hidden = !plan;
        $('[data-review-noplan]').hidden = !!plan;
        if (plan) {
          $('[data-rplan-name]').textContent = `${plan.name}: ${plan.promise}`;
          $('[data-rplan-body]').textContent = `${rs(plan.price)} a month. ${plan.features.slice(0, 3).join('. ')}.`;
        }
        $('[data-mkt-note]').textContent = plan ? `${plan.name} includes the numbers shown; anything above is added at the unit price.` : 'Priced per piece. A plan may cover the same for less.';
        const better = betterPlan(state);
        $('[data-nudge]').hidden = !better;
        if (better) {
          $('[data-nudge-text]').textContent = `${better.plan.name} covers everything you picked for ${rs(better.cost)} a month: ${rs(better.saves)} less than buying it piece by piece.`;
          const go = $('[data-nudge-go]');
          go.dataset.target = better.plan.id;
          go.textContent = `Switch to ${better.plan.name}`;
        }
        const from = state.ui.from;
        $('[data-back-label]').textContent = from === 'wizard' ? 'Back to the questions' : from === 'plans' ? 'Back to the plans' : 'Back';

        // cart
        const keys = new Set([...r.monthly, ...r.once].map((l) => l.key));
        for (const [which, lines] of [['monthly', r.monthly], ['once', r.once]]) {
          $(`[data-lines="${which}"]`).replaceChildren(...lines.map((l) => lineEl(l, prevKeys !== null && !prevKeys.has(l.key))));
          $(`[data-empty="${which}"]`).hidden = lines.length > 0;
        }
        prevKeys = keys;

        discount('m', r.m, discounts.monthly, plan ? ' a month in extras' : ' a month');
        discount('o', r.o, discounts.oneTime, '');

        const mRows = [];
        if (r.m.disc || r.m.prepay) mRows.push(['Subtotal', rs(r.m.sub)]);
        if (r.m.disc) mRows.push([`Volume discount ${plan ? 'on extras ' : ''}${Math.round(r.m.tier.rate * 100)}%`, `− ${rs(r.m.disc)}`, 'is-save']);
        if (r.m.prepay) mRows.push(['6 months paid up front, 5%', `− ${rs(r.m.prepay)}`, 'is-save']);
        const oRows = r.o.disc ? [['Subtotal', rs(r.o.sub)], [`Volume discount ${Math.round(r.o.tier.rate * 100)}%`, `− ${rs(r.o.disc)}`, 'is-save']] : [];
        sums($('[data-sums="m"]'), mRows);
        sums($('[data-sums="o"]'), oRows);

        tween($('[data-fig="m"]'), r.m.total);
        tween($('[data-fig="o"]'), r.o.total);
        tween($('[data-fig="due"]'), r.due.exVat + r.due.vat);
        tween($('[data-bar-m]'), r.m.total);
        tween($('[data-bar-o]'), r.o.total);
        $('[data-fig-s="m"]').textContent = r.m.total ? `+ VAT ${rs(r.m.vat)}${plan ? ` · ad budget ${plan.adBudget} paid to Meta` : ''}` : '';
        $('[data-fig-s="o"]').textContent = r.o.total ? `+ VAT ${rs(r.o.vat)}${r.o.hasFrom ? ' · includes “from” prices' : ''}` : '';
        const hasProjects = r.once.some((l) => !l.setup && l.amount > 0);
        $('[data-fig-s="due"]').textContent = r.due.exVat
          ? [r.due.months === 6 ? '6 months up front' : r.due.months ? 'first month' : '', r.once.some((l) => l.setup && l.amount) ? 'setup' : '', hasProjects ? '50% of one-time work' : '']
              .filter(Boolean).join(' + ') + ', incl. VAT'
          : '';
        const dueNote = $('[data-fig-s="due"]').textContent;

        // plans screen: the same lines and totals, set out under step 4
        const any = r.monthly.length + r.once.length > 0;
        $('[data-tot-empty]').hidden = any;
        $('[data-tot-body]').hidden = !any;
        for (const [which, lines] of [['monthly', r.monthly], ['once', r.once]]) {
          $(`[data-tot-lines="${which}"]`).replaceChildren(...lines.map((l) => lineEl(l, false)));
          $(`[data-tot-group="${which}"]`).hidden = !lines.length;
        }
        sums($('[data-tot-sums="m"]'), [...mRows, ['Monthly total', `${rs(r.m.total)} + VAT`, 'is-total']]);
        sums($('[data-tot-sums="o"]'), [...oRows, ['One-time total', `${rs(r.o.total)} + VAT`, 'is-total']]);
        $('[data-tot-due]').textContent = rs(r.due.exVat + r.due.vat);
        $('[data-tot-due-s]').textContent = dueNote;

        $('[data-client-echo]').textContent = state.client || (plan ? `${plan.name} plan` : 'Built by you');
        $('[data-cart-cta]').textContent = state.ui.screen === 'review' ? 'See my proposal' : 'See my package';

        renderProposal(r);
      }

      // ---- the proposal ------------------------------------------------------
      const ref = () => {
        const d = new Date();
        const n = [...JSON.stringify({ ...state, ui: 0 })].reduce((a, c) => (a * 31 + c.charCodeAt(0)) >>> 0, 7) % 9000 + 1000;
        return `NT-${String(d.getFullYear()).slice(2)}${String(d.getMonth() + 1).padStart(2, '0')}${String(d.getDate()).padStart(2, '0')}-${n}`;
      };
      const p = (k) => $(`[data-p="${k}"]`);

      function rows(tbody, lines, totals) {
        tbody.replaceChildren();
        for (const l of lines) {
          const tr = document.createElement('tr');
          if (l.credit) tr.className = 'is-save';
          const a = document.createElement('td');
          const n = document.createElement('span');
          n.className = 'pt-name';
          n.textContent = l.label;
          a.append(n);
          if (l.detail) { const dd = document.createElement('span'); dd.className = 'pt-detail'; dd.textContent = l.detail; a.append(dd); }
          const b = document.createElement('td');
          b.textContent = l.was
            ? (l.amount === 0 ? 'Waived' : (l.from ? 'from ' : '') + rs(l.amount))
            : (l.amount < 0 ? '− ' : '') + (l.from ? 'from ' : '') + rs(Math.abs(l.amount));
          tr.append(a, b);
          tbody.append(tr);
        }
        for (const [k, v, cls] of totals) {
          const tr = document.createElement('tr');
          tr.className = cls;
          const a = document.createElement('td');
          const b = document.createElement('td');
          a.textContent = k;
          b.textContent = v;
          tr.append(a, b);
          tbody.append(tr);
        }
      }

      function summary(r) {
        const out = [`Proposal ${ref()}${state.client ? ` for ${state.client}` : ''}`];
        if (r.plan) out.push(`Plan: ${r.plan.name}`);
        for (const l of [...r.monthly.filter((x) => !x.plan), ...r.once]) out.push(`- ${l.label}${l.qty ? ` (${l.detail})` : ''}`);
        if (r.m.total) out.push(`Monthly: ${rs(r.m.total)} + VAT`);
        if (r.o.total) out.push(`One-time: ${rs(r.o.total)} + VAT`);
        out.push(`Due to start: ${rs(r.due.exVat + r.due.vat)} incl. VAT`);
        return out.join('\n');
      }

      function renderProposal(r) {
        p('ref').textContent = ref();
        p('date').textContent = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
        p('client').textContent = state.client || 'Your business';
        p('by').textContent = state.staff ? `By ${state.staff}, Nine Technology` : 'Nine Technology, Lazimpat, Kathmandu';
        p('m').textContent = rs(r.m.total);
        p('m-s').textContent = r.m.total ? `+ 13% VAT · ${state.term === 12 ? '12-month term' : state.term === 6 ? '6 months paid up front' : '3-month minimum'}` : 'No monthly work';
        p('o').textContent = rs(r.o.total);
        p('o-s').textContent = r.o.total ? '+ 13% VAT · 50% to start, 50% on delivery' : 'No one-time work';
        p('due').textContent = rs(r.due.exVat + r.due.vat);
        p('due-s').textContent = 'Including VAT';

        $('[data-p-plan]').hidden = !r.plan;
        if (r.plan) {
          p('plan-name').textContent = r.plan.name;
          p('plan-promise').textContent = `${r.plan.promise}. ${r.plan.bestFor}. ${r.plan.reply}.`;
          p('plan-feat').replaceChildren(...r.plan.features.map((f) => { const li = document.createElement('li'); li.textContent = f; return li; }));
          p('sep').textContent = `${rs(r.separate)} a month`;
          p('plan-price').textContent = `${rs(r.plan.price)} a month`;
          p('save').textContent = `You save ${rs(r.separate - r.plan.price)} every month, ${rs((r.separate - r.plan.price) * 12)} a year.`;
        }

        $('[data-p-m]').hidden = !r.monthly.length;
        const mt = [];
        if (r.m.disc) mt.push([`Volume discount${r.plan ? ' on extras' : ''}, ${Math.round(r.m.tier.rate * 100)}%`, `− ${rs(r.m.disc)}`, 'is-save']);
        if (r.m.prepay) mt.push(['Six months paid up front, 5%', `− ${rs(r.m.prepay)}`, 'is-save']);
        mt.push(['Monthly total', rs(r.m.total), 'is-total'], ['VAT 13%', rs(r.m.vat), 'is-vat']);
        rows(p('m-lines'), r.monthly, mt);

        $('[data-p-o]').hidden = !r.once.length;
        const ot = [];
        if (r.o.disc) ot.push([`Volume discount, ${Math.round(r.o.tier.rate * 100)}%`, `− ${rs(r.o.disc)}`, 'is-save']);
        ot.push(['One-time total', rs(r.o.total), 'is-total'], ['VAT 13%', rs(r.o.vat), 'is-vat']);
        rows(p('o-lines'), r.once, ot);
        p('from-note').hidden = !r.o.hasFrom;
        p('ad').textContent = r.plan
          ? `Suggested ad budget for ${r.plan.name}: ${r.plan.adBudget} a month, paid by you directly to the platform.`
          : 'Ad budgets are paid by you directly to Meta, Google or TikTok, never through us.';

        const text = summary(r);
        const link = `${location.origin}${location.pathname}${location.hash}`;
        const hello = STAFF ? 'Hi Nine Technology, we accept this proposal.' : 'Hi Nine Technology, I built this package on your website.';
        $('[data-accept]').href = `https://wa.me/${WA}?text=${encodeURIComponent(`${hello}\n\n${text}\n\n${link}`)}`;
        $('[data-accept]').textContent = STAFF ? 'Accept on WhatsApp' : 'Send to Nine Technology';
        $('[data-send]').href = `https://wa.me/?text=${encodeURIComponent(`${text}\n\nThe full proposal: ${link}`)}`;
      }

      function commit() { save(); render(); }

      render();
      save();
    </script>
  </body>
</html>

