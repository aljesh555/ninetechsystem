---
/**
 * Build my package. Four screens, one package:
 *
 *   start     choose: a ready-made plan, or build your own
 *   plans     the four monthly plans; picking one goes straight to review
 *   wizard    build your own, one question at a time, as a conversation:
 *             website, then app, then marketing, then search and AI, then extras
 *   review    everything at once, every quantity adjustable, prices live
 *   proposal  the document the client reads, prints or sends on WhatsApp
 *
 * Linked from the home hero. `/builder?staff` adds a "prepared by" field and
 * "Send to client" for use in a pitch meeting.
 *
 * Prices live in src/data/packages.js; the arithmetic in
 * src/lib/package-price.js. The whole package, and the screen and question it
 * is on, are kept in the URL hash, so a refresh never loses it and a copied
 * link reopens the same quote.
 */
import '../styles/global.css';
import Stepper from '../components/builder/Stepper.astro';
import YesNo from '../components/builder/YesNo.astro';
import Levels from '../components/builder/Levels.astro';
import Step from '../components/builder/Step.astro';
import Opt from '../components/builder/Opt.astro';
import BigStepper from '../components/builder/BigStepper.astro';
import logoWhite from '../../assets/brand/logo-full-white.svg?raw';
import logoNavy from '../../assets/brand/logo-full-navy.svg?raw';
import { site } from '../data/site.js';
import {
  plans, units, platforms, levels, websites, apps, oneTime, terms, everyPlan,
  clientTerms, discounts,
} from '../data/packages.js';
import { npr, alaCarte } from '../lib/package-price.js';

const rs = (n) => `Rs ${npr(n)}`;
const mo = (n) => `${rs(n)} a month`;
const each = (k) => `${rs(units[k].unit)} each a month`;
const pct = (r) => `${Math.round(r * 100)}%`;
const lowest = Math.min(...plans.map((p) => p.price));
const discountLine = [
  `${pct(discounts.monthly.at(-1).rate)} off monthly work added on top of a plan from ${rs(discounts.monthly.at(-1).min)} a month, ${pct(discounts.monthly[0].rate)} from ${rs(discounts.monthly[0].min)}`,
  `${pct(discounts.oneTime.at(-1).rate)} off one-time work from ${rs(discounts.oneTime.at(-1).min)}, ${pct(discounts.oneTime[0].rate)} from ${rs(discounts.oneTime[0].min)}`,
];
const sections = [
  ['website', 'Website'],
  ['app', 'App'],
  ['marketing', 'Marketing'],
  ['search', 'Search & AI'],
  ['extras', 'Extras'],
  ['review', 'Review'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Build your package — Nine Technology</title>
    <meta name="description" content="Price your website, app, marketing and AI automation in two minutes: pick a monthly plan or answer a few questions. Every price in writing, in NPR." />
    <link rel="canonical" href={`${site.url}/builder`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content="Build your package — Nine Technology" />
    <meta property="og:description" content="Price your website, app, marketing and AI automation in two minutes: pick a monthly plan or answer a few questions. Every price in writing, in NPR." />
    <meta property="og:url" content={`${site.url}/builder`} />
    <meta property="og:image" content={`${site.url}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#123566" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/inter-400-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-700.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="bld scr-start">
    <header class="bld-top">
      <div class="bld-top-in">
        <a href="/" class="bld-logo" aria-label="Nine Technology — home"><Fragment set:html={logoWhite} /></a>
        <span class="bld-title">Build your package</span>
        <label class="bld-client bld-staff" data-staff-only hidden>
          <span>Prepared by</span>
          <input type="text" data-text="staff" placeholder="Your name" autocomplete="off" maxlength="40" />
        </label>
        <div class="bld-top-actions">
          <button type="button" class="bld-ghost" data-reset>Start over</button>
        </div>
      </div>
    </header>

    <!-- start ------------------------------------------------------------- -->
    <section class="start" data-screen="start" aria-labelledby="h-start">
      <div class="start-in">
        <p class="start-kicker">Build your package</p>
        <h1 class="start-title" id="h-start">What should we build for you<span class="stop" aria-hidden="true"></span></h1>
        <p class="start-lead">Pick a ready-made monthly plan, or answer a few questions and see exactly what your package costs. Prices update as you go, and nothing is sent until you choose to send it.</p>
        <div class="start-paths">
          <button type="button" class="path" data-go="plans">
            <span class="path-k">Ready-made</span>
            <span class="path-title">Choose a monthly plan</span>
            <span class="path-body">Four plans with filming, ads, an AI assistant and website care in one price. From {rs(lowest)} a month.</span>
            <span class="path-go">See the plans <span aria-hidden="true">→</span></span>
          </button>
          <button type="button" class="path path-main" data-act="custom">
            <span class="path-k">Custom</span>
            <span class="path-title">Build my own</span>
            <span class="path-body">A few questions, one at a time: your website, then an app, then marketing. About two minutes.</span>
            <span class="path-go">Start <span aria-hidden="true">→</span></span>
          </button>
        </div>
        <p class="start-note">All prices in NPR, excluding 13% VAT. {site.replyPromise}</p>
      </div>
    </section>

    <div class="bld-app" data-app>
      <main class="bld-main">
        <!-- plans ------------------------------------------------------- -->
        <section data-screen="plans" hidden aria-labelledby="h-plans">
          <header class="scr-head">
            <button type="button" class="back-link" data-go="start"><span aria-hidden="true">←</span> Back</button>
            <h1 id="h-plans">Ready-made plans<span class="stop" aria-hidden="true"></span></h1>
            <p>One team and one bill: filming, ads, an AI assistant and website care in one monthly price. Choose a package, add a website and search to it at 20% less, and see the total at the bottom.</p>
          </header>
          <header class="bld-sec-head plans-step">
            <span class="bld-num" aria-hidden="true">1</span>
            <div>
              <h2 id="h-plan-pick">Choose your package</h2>
              <p>Everything listed on a card is included in its monthly price.</p>
            </div>
          </header>
          <div class="plans plans-full" role="group" aria-labelledby="h-plan-pick">
            {plans.map((p) => (
              <button type="button" class:list={['plan', p.recommended && 'plan-rec']} data-plan={p.id}>
                {p.recommended && <span class="plan-flag">Most chosen</span>}
                <span class="plan-name">{p.name}</span>
                <span class="plan-promise">{p.promise}</span>
                <span class="plan-price"><span class="plan-cur">Rs</span>{npr(p.price)}<span class="plan-per">/month</span></span>
                <span class="plan-sep">Bought separately <s>{rs(alaCarte(p))}</s></span>
                <span class="plan-for">{p.bestFor}</span>
                <ul class="plan-feat">{p.features.map((f) => <li>{f}</li>)}</ul>
                <span class="plan-add" data-plan-added hidden></span>
                <span class="plan-pick" data-plan-pick={p.name}>Choose {p.name} <span aria-hidden="true">→</span></span>
              </button>
            ))}
          </div>

          <section class="bld-sec plan-extras" data-plan-extras aria-labelledby="h-plan-extras">
            <header class="bld-sec-head">
              <span class="bld-num" aria-hidden="true">2</span>
              <div>
                <h2 id="h-plan-extras">Add a website</h2>
                <p data-extras-note></p>
              </div>
            </header>
            <div class="q q-block">
              <div class="q-text"><p class="q-ask">Website</p><p class="q-cost" data-cost="web"></p></div>
              <div class="cards cards-4" role="group" aria-label="Website">
                <button type="button" class="card" data-path="web.type" data-v="none"><span class="card-name">None</span><span class="card-body">Not now.</span></button>
                {Object.entries(websites).map(([k, w]) => (
                  <button type="button" class="card" data-path="web.type" data-v={k}>
                    <span class="card-name">{w.label}</span>
                    <span class="card-body">{w.blurb}</span>
                    <span class="card-price" data-web-price={k}>{w.from ? 'From ' : ''}{rs(w.base)}</span>
                  </button>
                ))}
              </div>
            </div>
          </section>

          <section class="bld-sec" aria-labelledby="h-plan-seo">
            <header class="bld-sec-head">
              <span class="bld-num" aria-hidden="true">3</span>
              <div>
                <h2 id="h-plan-seo">Add search and AI visibility</h2>
                <p><span data-seo-note></span> <a class="link" href="/services/seo#tiers" target="_blank" rel="noopener">See what each tier includes</a></p>
              </div>
            </header>
            <div class="q q-block">
              <div class="q-text"><p class="q-ask">SEO / AEO / GEO</p><p class="q-cost" data-cost="seo"></p></div>
              <div class="cards cards-4" role="group" aria-label="SEO, AEO and GEO">
                {levels.seo.options.map((o, i) => (
                  <button type="button" class="card" data-path="seo" data-v={i}>
                    <span class="card-name">{i === 0 ? 'None' : o.name}</span>
                    <span class="card-body">{o.body}</span>
                    {o.price ? <span class="card-price" data-seo-price={i}>{mo(o.price)}</span> : null}
                  </button>
                ))}
              </div>
            </div>
          </section>

          <section class="bld-sec plan-total" aria-labelledby="h-plan-total">
            <header class="bld-sec-head">
              <span class="bld-num" aria-hidden="true">4</span>
              <div>
                <h2 id="h-plan-total">Your package total</h2>
                <p>It adds up as you choose. Monthly work and one-time work are totalled separately.</p>
              </div>
            </header>
            <p class="cart-empty" data-tot-empty>Choose a package, a website or a search tier above and the total appears here.</p>
            <div class="tot" data-tot-body hidden>
              <div class="tot-group" data-tot-group="monthly">
                <p class="cart-label">Every month</p>
                <ul class="lines" data-tot-lines="monthly"></ul>
                <dl class="sums" data-tot-sums="m"></dl>
              </div>
              <div class="tot-group" data-tot-group="once">
                <p class="cart-label">One time</p>
                <ul class="lines" data-tot-lines="once"></ul>
                <dl class="sums" data-tot-sums="o"></dl>
              </div>
              <div class="tot-due">
                <span class="tot-due-k">Due to start</span>
                <span class="tot-due-v" data-tot-due></span>
                <span class="tot-due-s" data-tot-due-s></span>
              </div>
            </div>
            <p class="plan-extras-cta"><button type="button" class="btn btn-primary" data-go="review">See my package <span aria-hidden="true">→</span></button></p>
          </section>

          <p class="plans-alt">Prefer to choose piece by piece? <button type="button" class="link-btn" data-act="custom">Build my own instead</button></p>
        </section>

        <!-- wizard ------------------------------------------------------ -->
        <section data-screen="wizard" hidden aria-label="Build my own">
          <nav class="prog" aria-label="Progress">
            <ol class="prog-steps">
              {sections.map(([id, label]) => (
                <li><button type="button" data-jump={id}>{label}</button></li>
              ))}
            </ol>
            <div class="prog-bar"><span class="prog-fill" data-prog></span></div>
          </nav>

          <div class="wiz">
            <p class="wiz-count"><span class="stop" aria-hidden="true"></span> <span data-sec-name></span> · <span data-count></span></p>

            <!-- website -->
            <Step id="web-type" sec="website" title="First, your website. What do you need?" sub="Registered in your name, with the domain and hosting included.">
              <div class="opts opts-2">
                <Opt path="web.type" v="none" advance title="Nothing new for now" body="We have one, or it can wait." />
                {Object.entries(websites).map(([k, w]) => (
                  <Opt path="web.type" v={k} advance title={w.label} body={w.blurb} price={`${w.from ? 'From ' : ''}${rs(w.base)}`} />
                ))}
              </div>
            </Step>
            <Step id="web-pages" sec="website" title="How many pages should it have?" sub="Home, About, Services and Contact would be four. You can change this later.">
              <BigStepper path="web.pages" max={40} unit="pages" cost="web" />
            </Step>
            <Step id="web-lang" sec="website" title="Should it speak Nepali and English?" sub={`The second language adds ${rs(websites.landing.bilingual)} to a landing page. Larger sites include it.`}>
              <div class="opts opts-2">
                <Opt path="web.bilingual" v="true" advance title="Nepali and English" price={`+ ${rs(websites.landing.bilingual)}`} />
                <Opt path="web.bilingual" v="false" advance title="One language is enough" />
              </div>
            </Step>
            <Step id="web-care" sec="website" title="Once it’s live, who looks after it?" sub="Hosting, security, backups, and the small changes every website needs.">
              <div class="opts opts-list">
                {levels.care.options.map((o, i) => (
                  <Opt path="care" v={i} advance title={i === 0 ? 'We’ll look after it ourselves' : o.name.replace(/^\+ /, 'Care with ')} body={o.body} price={o.price ? mo(o.price) : undefined} />
                ))}
              </div>
            </Step>

            <!-- app -->
            <Step id="app-need" sec="app" title="Next, do you need a mobile app?" sub="Published on the App Store and Google Play, in your company’s name.">
              <div class="opts opts-2">
                <Opt act="app:none" advance title="No app for now" />
                <Opt act="app:ios" advance title="iPhone (iOS)" body="App Store" />
                <Opt act="app:android" advance title="Android" body="Google Play" />
                <Opt act="app:both" advance title="Both" body={`The second platform adds ${pct(apps.secondPlatform)}, not double`} />
              </div>
            </Step>
            <Step id="app-tier" sec="app" title="What does the app need to do?" sub="A starting price. The final price is fixed in writing after we scope it together.">
              <div class="opts opts-list">
                {Object.entries(apps.tiers).map(([k, t]) => (
                  <Opt path="app.tier" v={k} advance title={t.label} body={t.body} price={`From ${rs(t.base)}`} />
                ))}
              </div>
            </Step>
            <Step id="app-care" sec="app" title="After launch, should we keep it updated?" sub="New iOS and Android versions arrive every year; apps that are not updated stop working.">
              <div class="opts opts-2">
                <Opt path="app.care" v="true" advance title="Yes, look after it" body="Store updates, OS compatibility, fixes" price={mo(apps.care)} />
                <Opt path="app.care" v="false" advance title="No, we’ll manage" />
              </div>
            </Step>
            <Step id="software" sec="app" title="Does the business need its own software?" sub="Orders, stock, bookings or staff in one system, instead of notebooks, Excel and WhatsApp.">
              <div class="opts opts-2">
                <Opt path="software" v="true" advance title="Yes, let’s talk about it" body="Scoped in writing before we start" price={`From ${rs(oneTime.software.price)}`} />
                <Opt path="software" v="false" advance title="Not right now" />
              </div>
            </Step>

            <!-- marketing -->
            <Step id="mkt" sec="marketing" title="Now, marketing. Should we run your social media?" sub="Posts, reels, ads and replies, planned a month ahead and approved by you before anything goes out.">
              <div class="opts opts-2">
                <Opt act="mkt:yes" advance title="Yes, run it for us" body="Next: which platforms, and how much" />
                <Opt act="mkt:no" advance title="Not now" body="Skip to search and AI" />
              </div>
            </Step>
            <Step id="platforms" sec="marketing" title="Where are your customers?" sub={`Facebook and Instagram are the base. Each platform added is ${mo(3000)}.`}>
              <div class="opts opts-3">
                {platforms.map((p) => (
                  <button type="button" class="opt opt-check" data-set="platforms" data-v={p.id}>
                    <span class="opt-mark" aria-hidden="true"></span>
                    <span class="opt-title">{p.label}</span>
                    <span class="opt-body">{p.base ? 'Included in management' : `+ ${mo(3000)}`}</span>
                  </button>
                ))}
              </div>
              <p class="big-cost big-cost-line" data-cost="platforms"></p>
            </Step>
            <Step id="graphics" sec="marketing" title="How many graphic posts a month?" sub="Offers, announcements, menus, festival greetings. Designed to your brand, in Nepali and English.">
              <BigStepper path="qty.graphics" max={units.graphics.max} unit={each('graphics')} cost="u-graphics" presets={[4, 8, 12, 20]} />
            </Step>
            <Step id="reels" sec="marketing" title="And short videos (reels)?" sub="Reels reach the most people on Facebook, Instagram and TikTok. We script, film and edit them.">
              <BigStepper path="qty.reels" max={units.reels.max} unit={each('reels')} cost="u-reels" presets={[0, 2, 4, 8, 12]} />
            </Step>
            <Step id="filming" sec="marketing" title="Should we come and film at your place?" sub="Real footage of your shop, team and product outperforms stock video. We batch it into one visit.">
              <div class="opts opts-2">
                <Opt path="qty.halfDays" v="0" advance title="No, use our photos and clips" />
                <Opt path="qty.halfDays" v="1" advance title="Half a day a month" price={mo(units.halfDays.unit)} />
                <Opt path="qty.halfDays" v="2" advance title="A full day a month" price={mo(units.halfDays.unit * 2)} />
                <Opt path="qty.halfDays" v="4" advance title="Two days a month" price={mo(units.halfDays.unit * 4)} />
              </div>
            </Step>
            <Step id="photos" sec="marketing" title="How many edited photos a month?" sub="Product, food, rooms, team: retouched and ready for posts, ads and your website.">
              <BigStepper path="qty.photos" max={units.photos.max} step={units.photos.step} unit={each('photos')} cost="u-photos" presets={[0, 10, 20, 30]} />
            </Step>
            <Step id="ads" sec="marketing" title="How many ad campaigns should run at once?" sub="Each campaign chases one goal: messages, calls, visits or sales. Your ad budget is paid to Meta directly, never through us.">
              <BigStepper path="qty.campaigns" max={units.campaigns.max} unit={`${rs(units.campaigns.unit)} per campaign a month`} cost="u-campaigns" presets={[0, 1, 2, 4]} />
            </Step>
            <Step id="boosts" sec="marketing" title="Any boosted posts on top?" sub="A quick push behind a post that is already doing well.">
              <BigStepper path="qty.boosts" max={units.boosts.max} unit={each('boosts')} cost="u-boosts" presets={[0, 2, 4, 8]} />
            </Step>
            <Step id="creators" sec="marketing" title="Would you like a hired creator on camera?" sub="Most businesses start with the owner or staff on camera; customers trust a face they will meet. A creator is billed at cost, agreed before booking.">
              <div class="opts opts-2">
                <Opt path="qty.creators" v="0" advance title="Owner or staff on camera" body="What we recommend to start" />
                <Opt path="qty.creators" v="1" advance title="One creator a month" price={`About ${mo(units.creators.unit)}`} />
                <Opt path="qty.creators" v="2" advance title="Two creators a month" price={`About ${mo(units.creators.unit * 2)}`} />
              </div>
            </Step>

            <!-- search and ai -->
            <Step id="seo" sec="search" title="When someone searches for a business like yours, what should they find?" sub="On Google, on Maps, and in the answers AI assistants give.">
              <div class="opts opts-list">
                {levels.seo.options.map((o, i) => (
                  <Opt path="seo" v={i} advance title={i === 0 ? 'Leave search for now' : o.name} body={o.body} price={o.price ? mo(o.price) : undefined} />
                ))}
              </div>
            </Step>
            <Step id="ai" sec="search" title="It’s 10pm and a customer messages you. Who answers?" sub="An AI assistant trained on your prices and FAQs, in Nepali and English, handing over to your team when it should.">
              <div class="opts opts-list">
                {levels.ai.options.map((o, i) => (
                  <Opt path="ai" v={i} advance title={i === 0 ? 'We answer ourselves, in the morning' : o.name.replace(/^\+ /, 'Plus ')} body={o.body} price={o.price ? mo(o.price) : undefined} />
                ))}
              </div>
            </Step>

            <!-- extras -->
            <Step id="extras" sec="extras" title="Anything else to add?" sub="Pick any. Quantities can be adjusted on the next screen.">
              <div class="opts opts-2">
                <Opt toggle="brandKit" on="true" off="false" title="Brand kit" body="Logo refresh, colours, fonts, post templates" price={rs(oneTime.brandKit.price)} />
                <Opt toggle="adFilm" on="standard" off="none" title="An ad film" body="30–60 seconds: script, crew, one talent" price={rs(oneTime.adFilm.standard.price)} />
                <Opt toggle="photoshoot" on="1" off="0" title="Product or menu photoshoot" body="25 edited photos" price={rs(oneTime.photoshoot.price)} />
                <Opt toggle="festival" on="1" off="0" title="Festival pack" body="Dashain or Tihar: 4 extra reels and a festive set" price={rs(oneTime.festival.price)} />
                <Opt toggle="agentic" on="3" off="0" title="AI agents in the office" body="Invoices, stock alerts, staff reports, email triage" price={`From ${rs(oneTime.agentic.base)}`} />
                <Opt toggle="server" on="true" off="false" title="Server setup" body="VPS, security, backups, monitoring" price={rs(oneTime.server.price)} />
                <Opt toggle="healthCheck" on="true" off="false" title="Digital Health Check" body="Your site, Google and social, against two competitors" price={rs(oneTime.healthCheck.price)} />
              </div>
            </Step>

            <footer class="wiz-foot">
              <button type="button" class="bld-ghost bld-ghost-dark" data-back><span aria-hidden="true">←</span> Back</button>
              <button type="button" class="link-btn wiz-skip" data-go="review">Skip to my package</button>
              <button type="button" class="btn btn-primary" data-next>Next <span aria-hidden="true">→</span></button>
            </footer>
          </div>
        </section>

        <!-- review ------------------------------------------------------ -->
        <section data-screen="review" hidden aria-labelledby="h-review">
          <header class="scr-head">
            <button type="button" class="back-link" data-back-review><span aria-hidden="true">←</span> <span data-back-label>Back</span></button>
            <h1 id="h-review">Your package<span class="stop" aria-hidden="true"></span></h1>
            <p>Everything at once. Adjust any number and the price follows.</p>
          </header>

          <section class="bld-sec" data-review-plan aria-labelledby="h-rplan">
            <div class="rplan">
              <div>
                <p class="rplan-k">Monthly plan</p>
                <h2 id="h-rplan" data-rplan-name>—</h2>
                <p class="rplan-body" data-rplan-body></p>
              </div>
              <div class="rplan-switch" role="group" aria-label="Change plan">
                {plans.map((p) => <button type="button" data-plan={p.id}>{p.name}<span>{rs(p.price)}</span></button>)}
              </div>
            </div>
            <button type="button" class="link-btn rplan-off" data-plan="">Remove the plan and price the monthly work piece by piece</button>
          </section>

          <div class="nudge" data-nudge hidden>
            <p><span class="stop" aria-hidden="true"></span> <span data-nudge-text></span></p>
            <button type="button" class="btn btn-primary" data-nudge-go>Switch</button>
          </div>
          <p class="rplan-cta" data-review-noplan><button type="button" class="link-btn" data-go="plans">Compare with the ready-made plans</button></p>

          <section class="bld-sec" aria-labelledby="h-rweb">
