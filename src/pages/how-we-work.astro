---
/**
 * How we work. Six steps in the founder's words, each with what the client
 * gets and what we need from them, under the promise: written scope, fixed
 * price, real dates, signed. Content: `process` in src/data/site.js.
 */
import Base from '../layouts/Base.astro';
import BuildHero from '../components/services/BuildHero.astro';
import FallHeading from '../components/services/FallHeading.astro';
import Faq from '../components/services/Faq.astro';
import CtaStrip from '../components/services/CtaStrip.astro';
import { icon } from '../lib/icons.js';
import { site, process, promise, trustBadges } from '../data/site.js';
import { breadcrumbList, faqPage, orgRef, abs } from '../lib/schema.js';

const path = '/how-we-work';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'How we work', path },
];
const cta = { label: 'Request a consultation', href: '/contact' };

const faqs = [
  {
    q: 'What happens if I need something extra during the project?',
    a: 'We quote the additional work in writing and you decide whether to proceed. Nothing is built or added to your invoice until you approve it, and the rest of the signed scope remains unchanged.',
  },
  {
    q: 'Can I see the work before it is finished?',
    a: 'Yes. You review progress throughout the project and approve each major stage before the next one begins, so there are no surprises at the end.',
  },
  {
    q: 'What if the design needs changes?',
    a: 'The design is presented to you and approved before development starts. Changes within the agreed scope are part of the work, and they are easiest to make at that stage, so we ask for your feedback at every sign-off.',
  },
  {
    q: 'Who owns the website or system at the end?',
    a: 'You do. The domain, hosting, logins and files are registered in your name, and your team is trained to use them. Everything remains yours, whoever you work with in future.',
  },
  {
    q: 'What happens after the support period?',
    a: 'Our team remains available. You can continue with a monthly care plan, or contact us whenever you need changes, fixes or new work. There is no obligation, and we look forward to supporting your business as it grows.',
  },
  {
    q: 'Do you use the same process for every project?',
    a: 'The six steps are the same on every project. How the build itself is organised, whether in a single sequence, in stages or in short sprints, depends on the project, and the proposal states which delivery model we will use.',
  },
];

const schema = [
  {
    '@type': 'HowTo',
    '@id': `${abs(path)}#process`,
    name: 'How Nine Technology delivers a project',
    description: promise,
    provider: orgRef,
    step: process.map((s, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: s.title,
      text: s.body,
      url: `${abs(path)}#step-${i + 1}`,
    })),
  },
  faqPage(path, faqs),
  breadcrumbList(crumbs),
];
---

<Base
  title="How We Work — Nine Technology, Kathmandu"
  description="Before any work begins, we document the problem, the solution, the scope and the timeline. Six steps from the first consultation to ongoing support."
  path={path}
  schema={schema}
>
  <BuildHero
    crumbs={crumbs}
    kicker="How we work"
    h1="How we work with you"
    sceneName="process"
    primary={cta}
    secondary={{ label: 'The six steps', href: '#steps' }}
    facts={trustBadges}
  >
    Every project with Nine Technology follows the same six steps: we understand your business, document the problem and the solution, confirm the scope together, build in stages you review, launch and hand everything over in your name, and continue to support you after launch.
  </BuildHero>

  <section class="section trust-band" aria-label="Our promise">
    <div class="wrap">
      <p class="trust">{promise}</p>
      <p class="trust-sub">Most IT companies describe similar stages. What makes the difference is accountability: what is agreed in writing, and whether it is delivered. These are the commitments we make on every project.</p>
    </div>
  </section>

  <section class="section section-tint" id="steps">
    <div class="wrap">
      <ol class="step-rows">
        {process.map((s, i) => (
          <li class="step-row reveal" id={`step-${i + 1}`}>
            <div class="step-mark">
              <span class="step-big" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <Fragment set:html={icon(s.icon, 56)} />
            </div>
            <div class="step-main">
              <h2>{s.title}</h2>
              <p class="step-body">{s.body}</p>
              <dl class="step-sides">
                <div>
                  <dt>What you get</dt>
                  <dd>{s.get}</dd>
                </div>
                <div>
                  <dt>What we need from you</dt>
                  <dd>{s.bring}</dd>
                </div>
              </dl>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Faq faqs={faqs} heading="Common questions" intro="What clients often ask before starting a project with us." tint={false} />

  <CtaStrip
    heading="Tell us about your project"
    body="Share what you would like to build or improve. Every engagement begins with a consultation, at no cost and with no obligation."
    primary={cta}
  />
</Base>
