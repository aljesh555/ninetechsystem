---
/**
 * Home. In order: what we build and run (hero), the position we take, the
 * operational problems we solve, the four groups and the disciplines behind
 * them, how we work, the sectors we work in, and how to start. The four
 * commitments are not repeated here: the hero strip states them and How we work
 * details them, so they live on About and the Services hub. Icons appear only where they carry meaning: the three problems and
 * the four groups (the process steps carry their own).
 */
import Base from '../layouts/Base.astro';
import HowWeWork from '../components/HowWeWork.astro';
import FallHeading from '../components/services/FallHeading.astro';
import Arrow from '../components/services/Arrow.astro';
import { icon, iconOnNavy, heroScene } from '../lib/icons.js';
import { site, industries, disciplines } from '../data/site.js';
import { groups } from '../data/services.js';

const consult = { label: 'Request a consultation', href: '/contact' };

const heroFacts = [
  { icon: 'website', value: 'Design to operations', label: 'Build, market, automate, support' },
  { icon: 'sheet', value: 'Documented before we start', label: 'Problem, solution, scope, timeline' },
  { icon: 'lock', value: 'Registered in your name', label: 'Domain, hosting, logins, code' },
  { icon: 'maintenance', value: 'Supported after launch', label: 'By the team that built it' },
];

const problems = [
  {
    icon: 'chat',
    pain: 'Enquiries arrive at 9pm. Nobody answers them until morning.',
    fix: 'Conversational AI on WhatsApp, Messenger and the website, in Nepali and English, with handover rules so qualified enquiries reach your team.',
    link: { label: 'AI automation', href: '/services/automate#assistants' },
  },
  {
    icon: 'sheet',
    pain: 'Orders live in a notebook, and the notebook goes home with one person.',
    fix: 'A single system of record for orders, customers and payments, with role-based access, so the business does not depend on one person being present.',
    link: { label: 'Custom software', href: '/services/software' },
  },
  {
    icon: 'gauge',
    pain: 'The monthly report gets typed by hand, out of three different files.',
    fix: 'Scheduled reporting built on live data from the systems you already use, delivered daily or weekly without anyone compiling it.',
    link: { label: 'Workflow automation', href: '/services/automate#reports' },
  },
];

const schema = [
  {
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    url: site.url,
    name: site.name,
    publisher: { '@id': `${site.url}/#organization` },
    inLanguage: 'en',
  },
];
---

<Base
  title="Nine Technology — Websites, Software & AI Automation in Kathmandu"
  description="We build and run the digital systems businesses in Kathmandu depend on: websites, custom software, marketing and AI automation, engineered to work as one."
  path="/"
  preloadDisplay={true}
  schema={schema}
>
  <section class="hero on-navy">
    <div class="wrap hero-grid">
      <div class="hero-copy hero-seq">
        <p class="display lines">
          <span class="ln"><span class="li">Your ambition,</span></span>
          <span class="ln"><span class="li">our engineering</span><span class="stop" aria-hidden="true"></span><span class="sr-only">.</span></span>
        </p>
        <h1>We build and run the digital systems businesses in Kathmandu depend on: websites, custom software, marketing and AI automation, engineered to work as one.</h1>
        <div class="btn-row">
          <a class="btn btn-primary" href={consult.href}>{consult.label}</a>
          <a class="btn btn-secondary" href={site.whatsapp} rel="noopener">Message us on WhatsApp</a>
        </div>
        <p class="hero-note">{site.replyPromise}</p>
      </div>
      <div class="hero-art hero-stage"><Fragment set:html={heroScene()} /></div>
    </div>
    <div class="wrap">
      <dl class="facts facts-dark facts-in">
        {heroFacts.map((f) => (
          <div>
            <Fragment set:html={iconOnNavy(f.icon, 44)} />
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section trust-band" aria-label="Our position">
    <div class="wrap">
      <p class="trust">Most businesses here run on systems nobody designed. A website from one vendor, a spreadsheet from another, and a WhatsApp thread holding the two together.</p>
      <p class="trust-sub">We design the whole of it: the system your records live in, the channels that bring people to it, and the automation that runs the work in between. Then we operate it with you. That is the difference between commissioning a website and building an operation that can grow.</p>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap">
      <div class="section-head">
        <FallHeading text="For businesses still running on paper, Excel and WhatsApp" />
        <p class="lead">Three patterns we are called in for most often, and what replaces each one.</p>
      </div>
      <ul class="problems stagger reveal">
        {problems.map((p) => (
          <li>
            <Fragment set:html={icon(p.icon, 52)} />
            <p class="problem-pain">{p.pain}</p>
            <p class="problem-fix">{p.fix}</p>
            <a class="svc-view" href={p.link.href}>{p.link.label} <Arrow /></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="what-we-do">
    <div class="wrap">
      <div class="section-head reveal">
        <h2 class="bundle-head">
          Build it<span class="stop" aria-hidden="true"></span><span class="sr-only">.</span>
          Grow it<span class="stop" aria-hidden="true"></span><span class="sr-only">.</span>
          Automate it<span class="stop" aria-hidden="true"></span><span class="sr-only">.</span>
          Support it<span class="stop" aria-hidden="true"></span><span class="sr-only">.</span>
        </h2>
        <p class="lead">Four disciplines under one team and one architecture. Take one or take all four; the same people stay with you from the first consultation through to support after launch.</p>
      </div>
      <div class="group-map stagger reveal">
        {groups.map((g) => (
          <a class="group-tile" href={g.page?.href ?? `/services#${g.id}`}>
            <Fragment set:html={icon(g.icon, 52)} />
            <span class="group-tile-name">{g.name}</span>
            <span class="group-tile-summary">{g.summary}</span>
            <span class="svc-view">Explore <Arrow /></span>
          </a>
        ))}
      </div>
      <div class="section-body">
        <h3 class="h4">What that involves in practice</h3>
        <ul class="chips">{disciplines.map((d) => <li>{d}</li>)}</ul>
      </div>
      <p class="section-body"><a class="svc-view" href="/services">All services <Arrow /></a></p>
    </div>
  </section>

  <HowWeWork tint />

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <FallHeading text="Sectors we work in" />
        <p class="lead">Every sector has its own operational shape. These are the patterns we see repeatedly in Kathmandu, and the systems we build against them.</p>
      </div>
      <ul class="sector-strip stagger reveal">
        {industries.map((i) => (
          <li>
            <a href={`/sectors#${i.slug}`}>
              <span class="sector-strip-name">{i.name}</span>
              <span class="sector-strip-brief">{i.brief}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="section-body"><a class="svc-view" href="/sectors">What each sector needs, in detail <Arrow /></a></p>
      <p class="company-note">{site.legalName}, {site.address.street}, {site.address.city}. Case studies are published with each client’s written permission; in a consultation we will take you through the work directly. <a class="link" href="/about">About the company</a>.</p>
    </div>
  </section>

  <section class="section section-navy on-navy">
    <div class="wrap">
      <h2>Tell us about your project</h2>
      <p class="lead">Describe what you need to build or improve. We reply {site.replyTime}, {site.hoursShort}, and the first consultation carries no cost and no obligation.</p>
      <div class="strip-actions">
        <a class="btn btn-primary" href={consult.href}>{consult.label}</a>
        <a class="btn btn-secondary" href={site.whatsapp} rel="noopener">Message us on WhatsApp</a>
      </div>
      <p class="strip-detail">
        <a href={site.phoneHref}>{site.phoneDisplay}</a><br />
        <a href={site.emailHref}>{site.email}</a><br />
        {site.address.display}<br />
        {site.hours}
      </p>
    </div>
  </section>
</Base>

<script>
  // The hero scene: its loops pause when the hero is off screen or the tab is
  // hidden, and the whole drawing tilts toward the pointer in perspective,
  // smoothed so it trails the cursor with a little weight. The tilt runs
  // through the Web Animations API, which the Content-Security-Policy allows
  // where an inline style would be refused. Mouse and trackpad only, never
  // under reduced motion.
  const stage = document.querySelector('.hero-stage');
  const svg = stage?.querySelector('svg');
  const hero = stage?.closest('section');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (stage && svg && hero && !still) {
    // Loops stop while the hero is off screen or the tab is hidden: the CSS
    // ones through .is-paused, the chart's SMIL through the SVG's own clock.
    let onScreen = true;
    const sync = () => {
      const paused = !onScreen || document.hidden;
      hero.classList.toggle('is-paused', paused);
      if (paused) svg.pauseAnimations(); else svg.unpauseAnimations();
    };
    new IntersectionObserver(([e]) => { onScreen = e.isIntersecting; sync(); }).observe(hero);
    document.addEventListener('visibilitychange', sync);

    // The chart starts re-measuring once the scene has assembled.
    svg.querySelectorAll('animateTransform').forEach((a, i) => (a as SVGAnimationElement).beginElementAt(3 + i * 0.4));

    // The tilt waits for the assembly to finish, and is dropped entirely
    // whenever it comes back to rest, so the drawing is only ever a 3D layer
    // while it is actually leaning.
    if (matchMedia('(hover: hover) and (pointer: fine)').matches && svg.animate) {
      const pose = (x: number, y: number) => ({ transform: `rotateX(${(y * -8).toFixed(3)}deg) rotateY(${(x * 11).toFixed(3)}deg)` });
      let tilt: Animation | null = null;
      let ready = false, tx = 0, ty = 0, x = 0, y = 0, raf = 0;
      setTimeout(() => { ready = true; }, 2300);
      // Per-piece depth, set as SVG transform attributes in the same frame
      // as the tilt: foreground pieces travel furthest. (Base.astro does this
      // for the other heroes with a CSS transition, which Chrome would
      // rasterise soft inside a tilted layer.)
      const depths = [...svg.querySelectorAll('.part > .depth')];
      const factor = [0.3, 0.8, 1, 1.6, 2];
      const place = () => depths.forEach((g, i) => g.setAttribute('transform', `translate(${(x * factor[i]).toFixed(2)} ${(y * factor[i] * 0.6).toFixed(2)})`));
      const step = () => {
        x += (tx - x) * 0.06;
        y += (ty - y) * 0.06;
        const settled = Math.abs(tx - x) + Math.abs(ty - y) < 0.0005;
        if (settled && !tx && !ty) {
          tilt?.cancel(); tilt = null; raf = 0; x = y = 0;
          depths.forEach((g) => g.removeAttribute('transform'));
          return;
        }
        place();
        const k = pose(x, y);
        if (!tilt) { tilt = svg.animate([k, k], { duration: 1000, fill: 'forwards' }); tilt.pause(); }
        else (tilt.effect as KeyframeEffect).setKeyframes([k, k]);
        raf = settled ? 0 : requestAnimationFrame(step);
      };
      const aim = (nx: number, ny: number) => {
        if (!ready) return;
        tx = Math.max(-1, Math.min(1, nx));
        ty = Math.max(-1, Math.min(1, ny));
        if (!raf) raf = requestAnimationFrame(step);
      };
      hero.addEventListener('pointermove', (e) => {
        const r = stage.getBoundingClientRect();
        aim((e.clientX - r.left - r.width / 2) / r.width, (e.clientY - r.top - r.height / 2) / r.height);
      });
      hero.addEventListener('pointerleave', () => aim(0, 0));
    }
  }
</script>
