---
/**
 * The services hub. It routes; the detail pages under /services/ explain.
 * Old links to /services#build, #grow, #automate and #support still land on
 * the matching group here, because each group section keeps that id.
 */
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/services/Breadcrumb.astro';
import ServiceCard from '../components/services/ServiceCard.astro';
import CtaStrip from '../components/services/CtaStrip.astro';
import Arrow from '../components/services/Arrow.astro';
import { site } from '../data/site.js';
import { services, groups, popularRequests, howToChoose, howWeWork, VAT_NOTE } from '../data/services.js';
import { breadcrumbList, service, abs } from '../lib/schema.js';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
];

const ordered = groups.flatMap((g) => g.services.map((id) => ({ ...services[id], group: g.name })));

const schema = [
  {
    '@type': 'ItemList',
    '@id': `${abs('/services')}#services`,
    name: 'Services from Nine Technology',
    itemListElement: ordered.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: service({ name: s.name, description: s.short, path: s.href, price: s.price, serviceType: s.group }),
    })),
  },
  breadcrumbList(crumbs),
];

const included = [
  'Scope and price in writing before we start',
  'Admin access to everything, registered in your name',
  'Support included after launch: 30 days on websites, 60 on software and apps',
  'One team builds, markets and maintains it',
];
---

<Base
  title="Services and Prices — Nine Technology, Kathmandu"
  description="Websites from NPR 20,000, custom software, apps, SEO, social media, AI automation and care plans in Kathmandu. Prices shown where the scope is standard."
  path="/services"
  schema={schema}
>
  <section class="page-head">
    <div class="wrap">
      <Breadcrumb crumbs={crumbs} />
      <h1>What we build, and what it costs</h1>
      <p class="lead">Four groups of work: we build the thing, bring customers to it, automate the work behind it, and keep it running. Prices are shown where the scope is standard; everything else is quoted after a free call.</p>
      <div class="btn-row section-body">
        <a class="btn btn-primary" href="/contact">Get a quote</a>
        <a class="btn btn-secondary" href={site.whatsapp} rel="noopener">Message us on WhatsApp</a>
      </div>
      <nav class="jump" aria-label="Service groups">
        {groups.map((g) => <a href={`#${g.id}`}>{g.name}</a>)}
      </nav>
    </div>
  </section>

  {groups.map((g, i) => (
    <section class={`section svc-group${i % 2 ? ' section-tint' : ''}`} id={g.id}>
      <div class="wrap">
        <div class="section-head reveal">
          <h2>{g.name}</h2>
          <p class="lead">{g.tagline}</p>
        </div>
        <div class="svc-grid stagger reveal">
          {g.services.map((id) => <ServiceCard service={services[id]} />)}
        </div>
        {i === groups.length - 1 && <p class="vat-note">{VAT_NOTE}</p>}
      </div>
    </section>
  ))}

  <section class="section">
    <div class="wrap split">
      <div class="split-head">
        <h2>How to choose</h2>
        <p>Start from the problem, not the product.</p>
      </div>
      <div>
        <dl class="choose">
          {howToChoose.map((c) => (
            <div>
              <dt>{c.q}</dt>
              <dd><a class="link" href={c.links[0]}>{c.a}</a></dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap split">
      <div class="split-head">
        <h2>Popular requests in Nepal</h2>
        <p>These are the things businesses in Kathmandu ask us for most.</p>
      </div>
      <ul class="plain-list">
        {popularRequests.map((r) => <li>{r}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="split-head">
        <h2>How we work</h2>
        <p>Five steps, in this order, on every project.</p>
      </div>
      <ol class="steps-list">
        {howWeWork.map((s) => (
          <li><strong>{s.title}</strong> — {s.body}</li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap split">
      <div class="split-head">
        <h2>What every project includes</h2>
        <p>In every contract we write, not just on this page.</p>
      </div>
      <ul class="plain-list included">
        {included.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>

  <CtaStrip />

  <script is:inline>
    // Cards tilt a few degrees toward the pointer. Mouse and trackpad only, and
    // never under reduced motion. Transform only, so it costs no layout.
    (() => {
      if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      for (const card of document.querySelectorAll('.svc-card')) {
        card.addEventListener('pointermove', (e) => {
          const r = card.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - 0.5;
          const y = (e.clientY - r.top) / r.height - 0.5;
          card.style.setProperty('--ry', (x * 12).toFixed(2) + 'deg');
          card.style.setProperty('--rx', (y * -12).toFixed(2) + 'deg');
        });
        card.addEventListener('pointerleave', () => {
          card.style.removeProperty('--rx');
          card.style.removeProperty('--ry');
        });
      }
    })();
  </script>
</Base>
