---
/**
 * The services hub. It routes; the service pages explain. Old links to
 * /services#build, #grow, #automate and #support still land on the matching
 * group here, because each group section keeps that id.
 */
import Base from '../layouts/Base.astro';
import BuildHero from '../components/services/BuildHero.astro';
import FallHeading from '../components/services/FallHeading.astro';
import ServiceCard from '../components/services/ServiceCard.astro';
import TierCards from '../components/services/TierCards.astro';
import Tiles from '../components/services/Tiles.astro';
import CtaStrip from '../components/services/CtaStrip.astro';
import Arrow from '../components/services/Arrow.astro';
import { icon, scene } from '../lib/icons.js';
import { site, commitments } from '../data/site.js';
import { services, groups, popularRequests, howToChoose, VAT_NOTE } from '../data/services.js';
import HowWeWork from '../components/HowWeWork.astro';
import { breadcrumbList, service, abs } from '../lib/schema.js';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
];
const proposal = { label: 'Request a proposal', href: '/contact' };
const total = groups.reduce((n, g) => n + g.services.length, 0);

const facts = [
  { icon: 'website', value: `4 groups, ${total} services`, label: 'Build, grow, automate, support' },
  { icon: 'users', value: 'One team', label: 'Builds, markets and maintains' },
  { icon: 'sheet', value: 'Documented proposal', label: 'Problem, solution and scope' },
  { icon: 'lock', value: 'In your name', label: 'Domain, hosting and logins' },
];

// Section backgrounds alternate from the first section after the hero.
const bg = (i) => (i % 2 === 0 ? ' section-tint' : '');

const commitmentIcons = ['sheet', 'lock', 'maintenance', 'users'];
const included = commitments.map((c, i) => ({ icon: commitmentIcons[i], name: c.title, body: c.body }));

const ordered = groups.flatMap((g) => g.services.map((id) => ({ ...services[id], group: g.name })));
const schema = [
  {
    '@type': 'ItemList',
    '@id': `${abs('/services')}#services`,
    name: 'Services from Nine Technology',
    itemListElement: ordered.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: service({ name: s.name, description: s.short, path: s.href, serviceType: s.group }),
    })),
  },
  breadcrumbList(crumbs),
];
---

<Base
  title="IT & Digital Services in Kathmandu — Nine Technology"
  description="Websites, software, apps, SEO, social media, video, ads, AI automation and support for businesses in Kathmandu. One team; every engagement in writing."
  path="/services"
  schema={schema}
>
  <BuildHero
    crumbs={crumbs}
    kicker="Services"
    h1="IT and digital services in Kathmandu"
    sceneName="services"
    primary={proposal}
    secondary={{ label: 'Message us on WhatsApp', href: site.whatsapp }}
    facts={facts}
  >
    Nine Technology is an IT and digital services company in Kathmandu. We build websites, software and apps, bring customers to them through search, social, video and ads, automate repetitive work with AI, and keep everything running — one team, with every engagement confirmed in a written proposal.
  </BuildHero>

  <section class={`section${bg(0)}`} id="groups">
    <div class="wrap">
      <div class="section-head">
        <FallHeading text="Four groups, one team" />
        <p class="lead">We build the thing, bring customers to it, automate the work behind it, and keep it running. Take one group or all four.</p>
      </div>
      <div class="group-map stagger reveal">
        {groups.map((g) => (
          <a class="group-tile" href={`#${g.id}`}>
            <Fragment set:html={icon(g.icon, 52)} />
            <span class="group-tile-name">{g.name}</span>
            <span class="group-tile-summary">{g.summary}</span>
            <span class="svc-view">{g.services.length} services <Arrow /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {groups.map((g, i) => (
    <section class={`section svc-group${bg(i + 1)}`} id={g.id}>
      <div class="wrap">
        <div class="group-head">
          <div class="section-head">
            <FallHeading text={g.name} stop />
            <p class="lead">{g.tagline}</p>
            {g.page && <p class="section-body"><a class="svc-view" href={g.page.href}>{g.page.label} <Arrow /></a></p>}
          </div>
          <div class="group-art reveal"><Fragment set:html={scene(g.scene)} /></div>
        </div>
        <div class="svc-grid stagger reveal">
          {g.services.map((id) => <ServiceCard service={services[id]} />)}
        </div>
        {/* A service sold in tiers shows every tier in full, under its group. */}
        {g.services.map((id) => services[id]).filter((s) => s.tiers).map((s) => (
          <div class="tier-block">
            <h3>{s.name}: what each tier includes</h3>
            <TierCards tiers={s.tiers} h="h4" />
            <p class="vat-note">{VAT_NOTE} <a class="link" href={s.href}>View the service</a></p>
          </div>
        ))}
      </div>
    </section>
  ))}

  <section class={`section${bg(groups.length + 1)}`}>
    <div class="wrap">
      <div class="section-head">
        <FallHeading text="Where to start" />
        <p class="lead">Start from the problem, not the product.</p>
      </div>
      <ul class="tiles tiles-2 start stagger reveal">
        {howToChoose.map((c) => (
          <li>
            <Fragment set:html={icon(c.icon, 52)} />
            <h3>{c.name}</h3>
            <p>{c.body}</p>
            <a class="svc-view" href={c.link.href}>{c.link.label} <Arrow /></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class={`section${bg(groups.length + 2)}`}>
    <div class="wrap split">
      <div class="split-head">
        <FallHeading text="Popular requests in Nepal" />
        <p>The work businesses in Kathmandu ask us for most. Each links to the service that covers it.</p>
      </div>
      <ul class="request-list">
        {popularRequests.map((r) => (
          <li><a href={r.href}><span>{r.label}</span><Arrow /></a></li>
        ))}
      </ul>
    </div>
  </section>

  <HowWeWork tint={bg(groups.length + 3) !== ''} />

  <section class={`section${bg(groups.length + 4)}`}>
    <div class="wrap">
      <div class="section-head">
        <FallHeading text="What every project includes" />
        <p class="lead">In every contract we write, not just on this page.</p>
      </div>
      <Tiles items={included} cols={2} />
    </div>
  </section>

  <CtaStrip primary={proposal} />

  <script is:inline>
    // Cards tilt a few degrees toward the pointer. Mouse and trackpad only, and
    // never under reduced motion. Transform only, so it costs no layout.
    (() => {
      if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      for (const card of document.querySelectorAll('.svc-card')) {
        card.addEventListener('pointermove', (e) => {
          const r = card.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - 0.5;
          const y = (e.clientY - r.top) / r.height - 0.5;
          card.style.setProperty('--ry', (x * 12).toFixed(2) + 'deg');
          card.style.setProperty('--rx', (y * -12).toFixed(2) + 'deg');
        });
        card.addEventListener('pointerleave', () => {
          card.style.removeProperty('--rx');
          card.style.removeProperty('--ry');
        });
      }
    })();
  </script>
</Base>
