---
import Base from '../layouts/Base.astro';
import Slot from '../components/Slot.astro';
import { site, groups, carePlans, faqs } from '../data/site.js';

const serviceSchema = groups.flatMap((g) =>
  g.services.map((s) => ({
    '@type': 'Service',
    name: s.name,
    serviceType: g.name,
    description: s.answer,
    provider: { '@id': `${site.url}/#business` },
    areaServed: site.areasServed.map((n) => ({ '@type': 'City', name: n })),
    url: `${site.url}/services#${g.id}`,
  })),
);

const schema = [
  ...serviceSchema,
  {
    '@type': 'FAQPage',
    '@id': `${site.url}/services#faq`,
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Services', item: `${site.url}/services` },
    ],
  },
];
---

<Base
  title="Services — Nine Technology, Kathmandu"
  description="Websites, online stores, booking systems, business software, SEO, social media, video, AI automation and monthly care plans, built in Kathmandu."
  path="/services"
  schema={schema}
>
  <section class="page-head">
    <div class="wrap">
      <h1>What we do, and how we quote it</h1>
      <p class="lead">Four groups of work: we build the thing, we bring customers to it, we automate the work behind it, and we keep it running.</p>
      <p class="lead">Every project is quoted on its own, after a free scoping call. We would rather look at what you actually need than put a number on this page that turns out to be wrong for you. You get the scope and the price in writing before any work starts.</p>
      <div class="btn-row section-body">
        <a class="btn btn-primary" href="/contact">Get a quote</a>
        <a class="btn btn-secondary" href="#faq">Read the common questions</a>
      </div>
    </div>
  </section>

  {groups.map((g) => (
    <section class="section" id={g.id}>
      <div class="wrap split">
        <div class="split-head">
          <h2>{g.name}</h2>
          <p>{g.promise}</p>
          <Slot name={g.slot} alt={`${g.name} work at Nine Technology`} ratio="4-3" class="section-body" sizes="(min-width: 900px) 320px, 100vw" />
        </div>

        <div>
          {g.services.map((s) => (
            <article class="service">
              <div class="service-top">
                <h3>{s.name}</h3>
                <p class="fact">{s.timeline}</p>
              </div>
              <p class="service-answer">{s.answer}</p>

              {(s.includes.length > 0 || s.excludes.length > 0) && (
                <div class="service-detail">
                  {s.includes.length > 0 && (
                    <div>
                      <h4>What you get</h4>
                      <ul>{s.includes.map((i) => <li>{i}</li>)}</ul>
                    </div>
                  )}
                  {s.excludes.length > 0 && (
                    <div class="excl">
                      <h4>Not included</h4>
                      <ul>{s.excludes.map((i) => <li>{i}</li>)}</ul>
                    </div>
                  )}
                </div>
              )}

              {s.note && <p class="service-note">{s.note}</p>}
              <a class="btn btn-secondary" href={s.cta.href}>{s.cta.label}</a>
            </article>
          ))}

          {g.id === 'support' && (
            <article class="service">
              <div class="service-top">
                <h3>Monthly care plans</h3>
                <p class="fact">Monthly</p>
              </div>
              <p class="service-answer">Three levels of ongoing cover, so you know exactly what is handled and how fast we answer. Quoted with the project.</p>
              <div class="care">
                <table>
                  <caption class="sr-only">Comparison of the three monthly care plans</caption>
                  <thead>
                    <tr>
                      <th scope="col"><span class="sr-only">What is included</span></th>
                      {carePlans.plans.map((p) => (
                        <th scope="col"><span class="plan-name">{p.name}</span></th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {carePlans.rows.map((row, i) => (
                      <tr>
                        <th scope="row">{row}</th>
                        {carePlans.plans.map((p) => <td>{p.values[i]}</td>)}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <a class="btn btn-secondary" href="/contact?need=care-plan">Ask about a care plan</a>
            </article>
          )}
        </div>
      </div>
    </section>
  ))}

  <section class="section section-tint" id="faq">
    <div class="wrap split">
      <div class="split-head">
        <h2>Common questions</h2>
        <p>The eight things business owners ask us before they sign anything.</p>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <article class="faq-item">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-navy on-navy">
    <div class="wrap">
      <h2>Not sure which of these you need?</h2>
      <p class="lead">Tell us what the business does and where the work piles up. We will tell you what would actually help, and what would be a waste of your money.</p>
      <div class="strip-actions">
        <a class="btn btn-primary" href="/contact">Get a quote</a>
        <a class="btn btn-secondary" href={site.whatsapp} rel="noopener">Message us on WhatsApp</a>
      </div>
    </div>
  </section>
</Base>
