---
/**
 * The services hub. It routes; the group pages and the service pages explain.
 * Each of the four groups has its own page (/services/build, /grow, /automate,
 * /support). Old links to /services#build, #grow, #automate and #support
 * still land on the matching tile, because each tile keeps that id.
 */
import Base from '../layouts/Base.astro';
import BuildHero from '../components/services/BuildHero.astro';
import FallHeading from '../components/services/FallHeading.astro';
import Tiles from '../components/services/Tiles.astro';
import CtaStrip from '../components/services/CtaStrip.astro';
import Arrow from '../components/services/Arrow.astro';
import { icon } from '../lib/icons.js';
import { site, commitments } from '../data/site.js';
import { services, groups, popularRequests, howToChoose } from '../data/services.js';
import HowWeWork from '../components/HowWeWork.astro';
import { breadcrumbList, service, abs } from '../lib/schema.js';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
];
const proposal = { label: 'Request a proposal', href: '/contact' };
const total = groups.reduce((n, g) => n + g.services.length, 0);

const facts = [
  { icon: 'website', value: `4 groups, ${total} services`, label: 'Build, grow, automate, support' },
  { icon: 'users', value: 'One team', label: 'Builds, markets and maintains' },
  { icon: 'sheet', value: 'Documented proposal', label: 'Problem, solution and scope' },
  { icon: 'lock', value: 'In your name', label: 'Domain, hosting and logins' },
];

// Section backgrounds alternate from the first section after the hero.
const bg = (i) => (i % 2 === 0 ? ' section-tint' : '');

const commitmentIcons = ['sheet', 'lock', 'maintenance', 'users'];
const included = commitments.map((c, i) => ({ icon: commitmentIcons[i], name: c.title, body: c.body }));

const ordered = groups.flatMap((g) => g.services.map((id) => ({ ...services[id], group: g.name })));
const schema = [
  {
    '@type': 'ItemList',
    '@id': `${abs('/services')}#services`,
    name: 'Services from Nine Technology',
    itemListElement: ordered.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: service({ name: s.name, description: s.short, path: s.href, serviceType: s.group }),
    })),
  },
  breadcrumbList(crumbs),
];
---

<Base
  title="IT & Digital Services in Kathmandu — Nine Technology"
  description="Websites, software, apps, SEO, social media, video, ads, AI automation and support for businesses in Kathmandu. One team; every engagement in writing."
  path="/services"
  schema={schema}
>
  <BuildHero
    crumbs={crumbs}
    kicker="Services"
    h1="IT and digital services in Kathmandu"
    sceneName="services"
    primary={proposal}
    secondary={{ label: 'Message us on WhatsApp', href: site.whatsapp }}
    facts={facts}
  >
    Nine Technology is an IT and digital services company in Kathmandu. We build websites, software and apps, bring customers to them through search, social, video and ads, automate repetitive work with AI, and keep everything running — one team, with every engagement confirmed in a written proposal.
  </BuildHero>

  <section class={`section${bg(0)}`} id="groups">
    <div class="wrap">
      <div class="section-head">
        <FallHeading text="Four groups, one team" />
        <p class="lead">We build the thing, bring customers to it, automate the work behind it, and keep it running. Take one group or all four. Each has its own page.</p>
      </div>
      <div class="group-map stagger reveal">
        {groups.map((g) => (
          <a class="group-tile" id={g.id} href={g.page.href}>
            <Fragment set:html={icon(g.icon, 52)} />
            <span class="group-tile-name">{g.name}</span>
            <span class="group-tile-summary">{g.summary}</span>
            <ul class="group-tile-list">{g.services.map((id) => <li>{services[id].name}</li>)}</ul>
            <span class="svc-view">View {g.name} <Arrow /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class={`section${bg(1)}`}>
    <div class="wrap">
      <div class="section-head">
        <FallHeading text="Where to start" />
        <p class="lead">Start from the problem, not the product.</p>
      </div>
      <ul class="tiles tiles-2 start stagger reveal">
        {howToChoose.map((c) => (
          <li>
            <Fragment set:html={icon(c.icon, 52)} />
            <h3>{c.name}</h3>
            <p>{c.body}</p>
            <a class="svc-view" href={c.link.href}>{c.link.label} <Arrow /></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class={`section${bg(2)}`}>
    <div class="wrap split">
      <div class="split-head">
        <FallHeading text="Popular requests in Nepal" />
        <p>The work businesses in Kathmandu ask us for most. Each links to the service that covers it.</p>
      </div>
      <ul class="request-list">
        {popularRequests.map((r) => (
          <li><a href={r.href}><span>{r.label}</span><Arrow /></a></li>
        ))}
      </ul>
    </div>
  </section>

  <HowWeWork tint={bg(3) !== ''} />

  <section class={`section${bg(4)}`}>
    <div class="wrap">
      <div class="section-head">
        <FallHeading text="What every project includes" />
        <p class="lead">In every contract we write, not just on this page.</p>
      </div>
      <Tiles items={included} cols={2} />
    </div>
  </section>

  <CtaStrip primary={proposal} />
</Base>
