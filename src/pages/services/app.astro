---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/services/Breadcrumb.astro';
import QuickAnswer from '../../components/services/QuickAnswer.astro';
import Tiles from '../../components/services/Tiles.astro';
import Flow from '../../components/services/Flow.astro';
import Faq from '../../components/services/Faq.astro';
import CtaStrip from '../../components/services/CtaStrip.astro';
import { site } from '../../data/site.js';
import { app, contactHref } from '../../data/services.js';
import { breadcrumbList, faqPage, service } from '../../lib/schema.js';

const path = '/services/app';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
  { name: 'App', path },
];
const ask = { label: 'Ask about an app', href: contactHref('mobile-app') };

const schema = [
  service({
    name: 'Mobile app development',
    description: 'Android and iPhone apps for businesses in Nepal, built to feel fast on mid-range phones and weak connections.',
    path,
    serviceType: 'Mobile app development',
  }),
  faqPage(path, app.faqs),
  breadcrumbList(crumbs),
];
---

<Base
  title="Mobile App Development in Kathmandu — Nine Technology"
  description="Android and iPhone apps for businesses in Nepal, fast on mid-range phones and weak connections. We tell you honestly when a web app will do instead."
  path={path}
  schema={schema}
>
  <section class="page-head">
    <div class="wrap">
      <Breadcrumb crumbs={crumbs} />
      <h1>Mobile app development in Kathmandu</h1>
      <QuickAnswer>
        Nine Technology builds Android and iPhone apps for businesses in Nepal, built to feel fast on mid-range phones and weak connections. Every app is quoted after a free call — and we'll tell you honestly when a progressive web app does the job for far less.
      </QuickAnswer>
      <p class="lead">Android and iPhone apps, built to feel fast on the mid-range phones your customers actually own — and to keep working when the connection doesn't.</p>
      <div class="btn-row section-body">
        <a class="btn btn-primary" href={ask.href}>{ask.label}</a>
        <a class="btn btn-secondary" href={site.whatsapp} rel="noopener">Message us on WhatsApp</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>What we build</h2>
        <p class="lead">One app for both stores, and the dashboard behind it.</p>
      </div>
      <Tiles items={app.whatWeBuild} />
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap split">
      <div class="split-head">
        <h2>Most businesses don't need a native app</h2>
      </div>
      <div class="prose">
        <p class="offer-intro">A well-built mobile website or a progressive web app often does the same job, works on every phone, costs far less, and needs no app-store approval. We'll tell you which you need before you spend on the expensive option.</p>
        <h3 class="h4">A real app makes sense when</h3>
        <ul class="checks">{app.whenReal.map((w) => <li>{w}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="split-head">
        <h2>Where apps usually go wrong</h2>
        <p>We plan for all four before we build, not after launch.</p>
      </div>
      <ul class="plain-list">{app.failPoints.map((f) => <li>{f}</li>)}</ul>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap split">
      <div class="split-head">
        <h2>Payments and subscriptions</h2>
      </div>
      <div class="prose">
        <p class="offer-intro">{app.payments}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="split-head">
        <h2>Built for the phones and networks in Nepal</h2>
      </div>
      <ul class="checks">{app.builtForNepal.map((b) => <li>{b}</li>)}</ul>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap">
      <div class="section-head">
        <h2>How we release it</h2>
        <p class="lead">Four stages, from plan to the store. A native app usually takes {app.time}.</p>
      </div>
      <Flow steps={app.release} />
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="split-head">
        <h2>What you get with a native app</h2>
      </div>
      <ul class="checks">{app.features.map((f) => <li>{f}</li>)}</ul>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap split">
      <div class="split-head">
        <h2>Common add-ons</h2>
        <p>Added when your app needs them, and quoted with it.</p>
      </div>
      <ul class="checks">{app.addons.map((a) => <li>{a}</li>)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="split-head">
        <h2>How we quote it</h2>
      </div>
      <div>
        <p class="offer-intro">{app.quote}</p>
        <h3 class="h4 section-body">What moves the price</h3>
        <ul class="plain-list">{app.priceMovers.map((m) => <li>{m}</li>)}</ul>
        <a class="btn btn-primary section-body" href={ask.href}>{ask.label}</a>
      </div>
    </div>
  </section>

  <Faq faqs={app.faqs} heading="App questions" />

  <CtaStrip
    heading="Ready to plan your app?"
    body="Tell us what your customers would use it for. If a web app does the job, we will say so — before you spend on the expensive option."
    primary={ask}
  />
</Base>
