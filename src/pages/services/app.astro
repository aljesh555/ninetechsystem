---
import Base from '../../layouts/Base.astro';
import BuildHero from '../../components/services/BuildHero.astro';
import FallHeading from '../../components/services/FallHeading.astro';
import Tiles from '../../components/services/Tiles.astro';
import Groups from '../../components/services/Groups.astro';
import Compare from '../../components/services/Compare.astro';
import Flow from '../../components/services/Flow.astro';
import DeliveryModels from '../../components/services/DeliveryModels.astro';
import Faq from '../../components/services/Faq.astro';
import CtaStrip from '../../components/services/CtaStrip.astro';
import { app, contactHref } from '../../data/services.js';
import { breadcrumbList, faqPage, service } from '../../lib/schema.js';

const path = '/services/app';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
  { name: 'App', path },
];
const consult = { label: 'Schedule a consultation', href: contactHref('mobile-app') };

const schema = [
  service({
    name: 'Mobile app development',
    description: 'Android and iPhone apps for businesses in Nepal, built to feel fast on mid-range phones and weak connections.',
    path,
    serviceType: 'Mobile app development',
  }),
  faqPage(path, app.faqs),
  breadcrumbList(crumbs),
];
---

<Base
  title="Mobile App Development in Kathmandu — Nine Technology"
  description="Android and iPhone apps for businesses in Nepal, tested on mid-range phones and weak networks, with store submission handled and honest advice on web apps."
  path={path}
  schema={schema}
>
  <BuildHero
    crumbs={crumbs}
    kicker="Build — App"
    h1="Mobile app development in Kathmandu"
    sceneName="app"
    primary={consult}
    secondary={{ label: 'App or web app?', href: '#choose' }}
    facts={app.facts}
  >
    Nine Technology builds Android and iPhone apps for businesses in Nepal, engineered to feel fast on mid-range phones and weak connections. Every app is priced in a written proposal — and where a progressive web app meets the need at far lower cost, that is what we recommend.
  </BuildHero>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <FallHeading text="What we build" />
        <p class="lead">One app for both stores, and the dashboard your team uses to run it.</p>
      </div>
      <Tiles items={app.whatWeBuild} />
    </div>
  </section>

  <section class="section section-tint" id="choose">
    <div class="wrap">
      <div class="section-head">
        <FallHeading text="The right product for the job" />
        <p class="lead">Most businesses are best served by a mobile website or a progressive web app. We recommend a native app only when the product requires one — and we make that recommendation before any money is spent.</p>
      </div>
      <Compare {...app.comparison} caption="Progressive web app compared with a native app" />
      <h3 class="h4 section-body">A native app is the right choice when</h3>
      <ul class="chips">{app.whenReal.map((w) => <li>{w}</li>)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <FallHeading text="Risks we design out" />
        <p class="lead">The four most common reasons apps fail after launch, and how each one is prevented before development begins.</p>
      </div>
      <Tiles items={app.risks} cols={2} />
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap split">
      <div class="split-head">
        <FallHeading text="Payments and subscriptions" />
      </div>
      <div class="prose">
        <p class="offer-intro">{app.payments}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="split-head">
        <FallHeading text="Built for Nepali phones and networks" />
      </div>
      <ul class="checks one">{app.builtForNepal.map((b) => <li>{b}</li>)}</ul>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap split">
      <div class="split-head">
        <FallHeading text="What you receive" />
        <p>Delivered complete: built, tested, published and supported.</p>
      </div>
      <Groups groups={app.deliverables} />
    </div>
  </section>

  <section class="section" id="process">
    <div class="wrap">
      <div class="section-head">
        <FallHeading text="How we release it" />
        <p class="lead">Four stages from plan to store. A native app usually takes {app.time}.</p>
      </div>
      <Flow steps={app.release} />
    </div>
  </section>

  <DeliveryModels page="app" tint />

  <section class="section">
    <div class="wrap split">
      <div class="split-head">
        <FallHeading text="Common add-ons" />
        <p>Added when the product needs them, and included in the proposal.</p>
      </div>
      <ul class="chips">{app.addons.map((a) => <li>{a}</li>)}</ul>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap split">
      <div class="split-head">
        <FallHeading text="Engagement and pricing" />
      </div>
      <div>
        <p class="offer-intro">{app.quote}</p>
        <h3 class="h4 section-body">What determines the price</h3>
        <ul class="chips">{app.priceMovers.map((m) => <li>{m}</li>)}</ul>
        <a class="btn btn-primary section-body" href={consult.href}>{consult.label}</a>
      </div>
    </div>
  </section>

  <Faq tint={false} faqs={app.faqs} heading="App questions" />

  <CtaStrip
    heading="Plan your app with our team"
    body="Tell us who will use it and what it must do. If a progressive web app meets the need, we will recommend it — before you commit to the larger investment."
    primary={consult}
  />
</Base>
