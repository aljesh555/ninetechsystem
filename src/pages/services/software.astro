---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/services/Breadcrumb.astro';
import QuickAnswer from '../../components/services/QuickAnswer.astro';
import Faq from '../../components/services/Faq.astro';
import CtaStrip from '../../components/services/CtaStrip.astro';
import { software, howWeWork, npr, contactHref, VAT_NOTE } from '../../data/services.js';
import { breadcrumbList, faqPage, service } from '../../lib/schema.js';

const path = '/services/software';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
  { name: 'Software', path },
];
const from = npr(software.price.from);

const schema = [
  service({
    name: 'Custom software development',
    description: 'Custom business software built around how your business works: billing, inventory, CRM, portals and dashboards.',
    path,
    price: software.price,
    serviceType: 'Custom software development',
  }),
  faqPage(path, software.faqs),
  breadcrumbList(crumbs),
];
---

<Base
  title="Custom Software Development in Kathmandu — Nine Technology"
  description={`Custom software in Nepal: billing, inventory, CRM, portals and dashboards, built around how you work. From NPR ${from}, priced in writing.`}
  path={path}
  schema={schema}
>
  <section class="page-head">
    <div class="wrap">
      <Breadcrumb crumbs={crumbs} />
      <h1>Custom software development in Kathmandu</h1>
      <QuickAnswer>
        Nine Technology builds custom business software in Nepal — billing, inventory, CRM, portals and dashboards — around how your business actually works. Projects start from NPR {from} and are scoped and priced in writing after a free call.
      </QuickAnswer>
      <p class="lead">Custom software built around how your business actually works — replacing Excel files, WhatsApp threads and paper registers with one system your team can rely on.</p>
      <div class="btn-row section-body">
        <a class="btn btn-primary" href={contactHref('software')}>Book a free scoping call</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="split-head">
        <h2>Systems we build most often</h2>
        <p>Software should remove operational friction. We focus on clarity, roles, predictable data, and a baseline that is easy to maintain.</p>
      </div>
      <div>
        <dl class="systems">
          {software.systems.map((s) => (
            <div>
              <dt>{s.name}</dt>
              <dd>{s.body}</dd>
            </div>
          ))}
        </dl>
        <p class="price-movers">Common uses: billing, inventory, POS, CRM, school and clinic management, HR, cooperative systems, and booking.</p>
      </div>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap split">
      <div class="split-head">
        <h2>Why custom, not off-the-shelf</h2>
      </div>
      <div class="prose">
        <p>Ready-made software makes you change how you work to fit it. Custom software fits how you already work. You own it, we build only what you need, and it grows with you.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="split-head">
        <h2>What you get</h2>
      </div>
      <ul class="checks">{software.features.map((f) => <li>{f}</li>)}</ul>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap split">
      <div class="split-head">
        <h2>How we work</h2>
        <p>Five steps, in this order.</p>
      </div>
      <ol class="steps-list">
        {howWeWork.map((s) => <li><strong>{s.title}</strong> — {s.body}</li>)}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="split-head">
        <h2>Price</h2>
        <p class="offer-price">From NPR {from}</p>
      </div>
      <div>
        <p class="offer-intro">Quoted per project after a free scoping call. Most custom software starts from NPR {from}.</p>
        <h3 class="h4 section-body">What moves the price</h3>
        <ul class="plain-list">{software.priceMovers.map((m) => <li>{m}</li>)}</ul>
        <p class="vat-note">{VAT_NOTE}</p>
        <a class="btn btn-primary section-body" href={contactHref('software')}>Book a free scoping call</a>
      </div>
    </div>
  </section>

  <Faq faqs={software.faqs} heading="Software questions" />

  <CtaStrip
    heading="Tell us where the work piles up"
    body="Which files, registers or WhatsApp threads your team spends the day in. We will tell you what a system would replace, and what it would cost."
    primary={{ label: 'Book a free scoping call', href: contactHref('software') }}
  />
</Base>
