---
import Base from '../../layouts/Base.astro';
import BuildHero from '../../components/services/BuildHero.astro';
import FallHeading from '../../components/services/FallHeading.astro';
import Tiles from '../../components/services/Tiles.astro';
import Groups from '../../components/services/Groups.astro';
import Compare from '../../components/services/Compare.astro';
import Flow from '../../components/services/Flow.astro';
import DeliveryModels from '../../components/services/DeliveryModels.astro';
import Faq from '../../components/services/Faq.astro';
import CtaStrip from '../../components/services/CtaStrip.astro';
import { software, contactHref } from '../../data/services.js';
import { breadcrumbList, faqPage, service } from '../../lib/schema.js';

const path = '/services/software';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
  { name: 'Software', path },
];
const consult = { label: 'Schedule a consultation', href: contactHref('software') };

const schema = [
  service({
    name: 'Custom software development',
    description: 'Custom business software built around how your business works: billing, inventory, CRM, portals and dashboards.',
    path,
    serviceType: 'Custom software development',
  }),
  faqPage(path, software.faqs),
  breadcrumbList(crumbs),
];
---

<Base
  title="Custom Software Development in Kathmandu — Nine Technology"
  description="Custom business software in Nepal: billing, inventory, CRM, portals and dashboards, built around how you work, delivered in stages and owned by you."
  path={path}
  schema={schema}
>
  <BuildHero
    crumbs={crumbs}
    kicker="Build — Software"
    h1="Custom software development in Kathmandu"
    sceneName="software"
    primary={consult}
    secondary={{ label: 'How we deliver', href: '#process' }}
    facts={software.facts}
  >
    Nine Technology builds custom business software in Nepal — billing, inventory, CRM, portals and dashboards — around how your business actually works. Every system is scoped and priced in a written proposal, delivered in stages, and handed over in your name.
  </BuildHero>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <FallHeading text="Systems we build most often" />
        <p class="lead">Software should remove operational friction. We focus on clarity, roles, predictable data, and a baseline that is easy to maintain.</p>
      </div>
      <Tiles items={software.systems} />
      <h3 class="h4 section-body">Common uses</h3>
      <ul class="chips">{software.commonUses.map((u) => <li>{u}</li>)}</ul>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap">
      <div class="section-head">
        <FallHeading text="Why custom, not off-the-shelf" />
        <p class="lead">Ready-made software makes you change how you work to fit it. Custom software fits how you already work. You own it, we build only what you need, and it grows with you.</p>
      </div>
      <Compare {...software.comparison} caption="Off-the-shelf software compared with custom software" />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <FallHeading text="Integrations and payments" />
        <p class="lead">{software.integrationsIntro}</p>
      </div>
      <Tiles items={software.integrations} cols={2} />
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap">
      <div class="section-head">
        <FallHeading text="Engineering standards" />
        <p class="lead">Three principles we do not trade away to deliver faster.</p>
      </div>
      <Tiles items={software.pillars} />
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="split-head">
        <FallHeading text="What you receive" />
        <p>Every system is delivered complete: built, connected, documented and handed over.</p>
      </div>
      <Groups groups={software.deliverables} />
    </div>
  </section>

  <section class="section section-tint" id="process">
    <div class="wrap">
      <div class="section-head">
        <FallHeading text="How we deliver" />
        <p class="lead">Four stages, in this order, with your approval at each one. Most systems take 6 to 12 weeks.</p>
      </div>
      <Flow steps={software.delivery} />
    </div>
  </section>

  <DeliveryModels page="software" />

  <section class="section section-tint">
    <div class="wrap split">
      <div class="split-head">
        <FallHeading text="Hosting and operations" />
        <p>A system has to keep working long after launch day.</p>
      </div>
      <ul class="checks one">{software.operations.map((o) => <li>{o}</li>)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="split-head">
        <FallHeading text="Engagement and pricing" />
      </div>
      <div>
        <p class="offer-intro">{software.quote}</p>
        <h3 class="h4 section-body">What determines the price</h3>
        <ul class="chips">{software.priceMovers.map((m) => <li>{m}</li>)}</ul>
        <a class="btn btn-primary section-body" href={consult.href}>{consult.label}</a>
      </div>
    </div>
  </section>

  <Faq faqs={software.faqs} heading="Software questions" />

  <CtaStrip
    heading="Discuss your system with our team"
    body="Tell us which files, registers and message threads your team works from today. We will outline what a system would replace, and follow with a written proposal."
    primary={consult}
  />
</Base>
