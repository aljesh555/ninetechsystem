---
/**
 * Support & Maintenance. Capability shown, no published price: care plans are
 * scoped per client. `#hosting`, `#handle` and `#care-plans` are the anchors
 * the hub cards link to. See DECISIONS.md.
 */
import Base from '../../layouts/Base.astro';
import BuildHero from '../../components/services/BuildHero.astro';
import FallHeading from '../../components/services/FallHeading.astro';
import Tiles from '../../components/services/Tiles.astro';
import Flow from '../../components/services/Flow.astro';
import Faq from '../../components/services/Faq.astro';
import CtaStrip from '../../components/services/CtaStrip.astro';
import { support, contactHref } from '../../data/services.js';
import { site } from '../../data/site.js';
import { breadcrumbList, faqPage, orgRef, abs, areaServed } from '../../lib/schema.js';

const path = '/services/support';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
  { name: 'Support', path },
];
const cta = { label: support.cta.label, href: contactHref(support.cta.need) };

// No offers: there is no published price yet.
const schema = [
  {
    '@type': 'Service',
    name: 'Website support and maintenance',
    serviceType: 'Website and software maintenance',
    description: support.answer,
    provider: orgRef,
    areaServed,
    url: abs(path),
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Support and maintenance',
      itemListElement: [...support.handle.map((h) => h.name), 'Monthly care plans'].map((name) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name },
      })),
    },
  },
  faqPage(path, support.faqs),
  breadcrumbList(crumbs),
];
---

<Base
  title="Support & Maintenance — Nine Technology, Kathmandu"
  description="Website and software support in Nepal: hosting, updates, security, backups and monthly care plans. Everything in your name, and a team that responds."
  path={path}
  schema={schema}
>
  <BuildHero
    crumbs={crumbs}
    kicker="Support — Support & maintenance"
    h1="Website Support & Maintenance in Kathmandu"
    sceneName="support"
    primary={cta}
    secondary={{ label: 'What we handle', href: '#handle' }}
    facts={support.facts}
  >
    {support.answer}
  </BuildHero>

  <section class="section trust-band" aria-label="Our ownership commitment">
    <div class="wrap">
      <p class="trust">{support.trust}</p>
      <p class="trust-sub">{support.intro}</p>
    </div>
  </section>

  <section class="section section-tint" id="handle">
    <div class="wrap">
      <div class="section-head">
        <FallHeading text="What we handle" />
        <p class="lead">Everything that keeps a website, store or system healthy after launch.</p>
      </div>
      <Tiles items={support.handle} />
    </div>
  </section>

  <section class="section" id="care-plans">
    <div class="wrap">
      <div class="section-head">
        <FallHeading text="Care plans" />
        <p class="lead">{support.carePlans}</p>
      </div>
      <h3 class="h4 section-body">How a plan is scoped</h3>
      <Tiles items={support.planFactors} />
    </div>
  </section>

  <section class="section section-tint" id="process">
    <div class="wrap">
      <div class="section-head">
        <FallHeading text="How support works" />
        <p class="lead">Five stages, from a first look at what you have to help whenever you need it.</p>
      </div>
      <Flow steps={support.process} />
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="split-head">
        <FallHeading text="How we price it" />
      </div>
      <div>
        <p class="offer-intro">{support.pricing}</p>
        <a class="btn btn-primary section-body" href={cta.href}>{cta.label}</a>
      </div>
    </div>
  </section>

  <Faq faqs={support.faqs} heading="Support questions" />

  <CtaStrip
    heading="Tell us what you need looked after"
    body="Your website, store or system, where it is hosted, and what keeps going wrong. We will put together a support plan."
    primary={cta}
  />
</Base>
