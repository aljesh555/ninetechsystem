---
import Base from '../../layouts/Base.astro';
import BuildHero from '../../components/services/BuildHero.astro';
import FallHeading from '../../components/services/FallHeading.astro';
import Tiles from '../../components/services/Tiles.astro';
import Groups from '../../components/services/Groups.astro';
import Flow from '../../components/services/Flow.astro';
import DeliveryModels from '../../components/services/DeliveryModels.astro';
import Faq from '../../components/services/Faq.astro';
import CtaStrip from '../../components/services/CtaStrip.astro';
import Arrow from '../../components/services/Arrow.astro';
import { icon } from '../../lib/icons.js';
import { website, priceLabel, npr, contactHref } from '../../data/services.js';
import { breadcrumbList, faqPage, service } from '../../lib/schema.js';

const path = '/services/website';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
  { name: 'Website', path },
];
const [landing, business, store] = website.offers;
const newSite = website.offers.filter((o) => !o.forExisting);
const redesign = website.offers.find((o) => o.id === 'redesign');
const proposal = { label: 'Request a proposal', href: contactHref('website') };

const schema = [
  ...website.offers.map((o) =>
    service({ name: o.name, description: o.intro, path: `${path}#${o.id}`, price: o.price, serviceType: 'Website design and development' }),
  ),
  faqPage(path, website.faqs),
  breadcrumbList(crumbs),
];
---

<Base
  title="Website Design & Prices in Kathmandu — Nine Technology"
  description={`Custom websites in Kathmandu: landing pages from NPR ${npr(landing.price.from)}, business sites from NPR ${npr(business.price.from)}, online stores from NPR ${npr(store.price.from)}. Fast, found on Google, yours.`}
  path={path}
  schema={schema}
>
  <BuildHero
    crumbs={crumbs}
    kicker="Build — Website"
    h1="Website design and development in Kathmandu"
    sceneName="website"
    primary={proposal}
    secondary={{ label: 'Compare formats', href: '#formats' }}
    facts={website.facts}
  >
    Nine Technology builds custom websites for businesses in Nepal — landing pages from NPR {npr(landing.price.from)}, business websites from NPR {npr(business.price.from)} and online stores from NPR {npr(store.price.from)}, with redesigns of existing sites from NPR {npr(redesign.price.from)}. Every site is custom-designed, fast on Nepali mobile networks, built to be found on Google and AI search, and handed over in your name with a CMS and training.
  </BuildHero>

  <section class="section" id="formats">
    <div class="wrap">
      <div class="section-head">
        <FallHeading text="Five formats, one standard" />
        <p class="lead">Four formats for a new website, and one for improving the site you already have. Every format is built to the same standard of design, performance and ownership.</p>
      </div>
      <div class="formats stagger reveal">
        {newSite.map((o) => (
          <article class="format">
            <h3>{o.name}</h3>
            <p class="format-price">{priceLabel(o.price, o.priceNote)}</p>
            <p class="format-time">{o.time}</p>
            <ul>{o.highlights.map((h) => <li>{h}</li>)}</ul>
            <a class="svc-view" href={`#${o.id}`}>Full specification <Arrow /></a>
          </article>
        ))}
      </div>
      <article class="format format-wide reveal">
        <div class="format-wide-head">
          <p class="kicker">Already have a website?</p>
          <h3>{redesign.name}</h3>
          <p class="format-price">{priceLabel(redesign.price)}</p>
          <p class="format-time">{redesign.time}</p>
        </div>
        <div class="format-tiers">
          {redesign.tiers.map((t) => (
            <div>
              <h4>{t.name}</h4>
              <p class="format-tier-price">{priceLabel(t.price)}</p>
              <p>{t.body}</p>
            </div>
          ))}
        </div>
        <a class="svc-view" href="#redesign">Full specification <Arrow /></a>
      </article>
      <p class="vat-note">{website.priceFootnote}</p>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap">
      <div class="section-head">
        <FallHeading text="What every website includes" />
        <p class="lead">The standard we hold every project to, whichever format you choose.</p>
      </div>
      <Tiles items={website.standards} />
    </div>
  </section>

  {website.offers.map((o, i) => (
    <section class={`section offer${i % 2 ? ' section-tint' : ''}`} id={o.id}>
      <div class="wrap split">
        <div class="split-head">
          <div class="offer-icon"><Fragment set:html={icon(o.icon, 64)} /></div>
          <h2>{o.name}</h2>
          <p class="offer-price">{priceLabel(o.price, o.priceNote)}</p>
          <p class="offer-time">Delivery: {o.time}</p>
          <a class="btn btn-primary section-body" href={contactHref(o.cta.need)}>{o.cta.label}</a>
        </div>
        <div>
          <p class="offer-intro">{o.intro}</p>
          {o.lead && <p class="offer-lead">{o.lead}</p>}
          {o.tiers && (
            <div class="tier-cards section-body">
              {o.tiers.map((t) => (
                <div class="tier-card">
                  <h3>{t.name}</h3>
                  <p class="format-tier-price">{priceLabel(t.price)}</p>
                  <p>{t.body}</p>
                </div>
              ))}
            </div>
          )}
          {(o.groups || o.clusters) && (
            <div class="section-body">
              <Groups groups={o.groups ?? o.clusters} />
            </div>
          )}
          {o.included && (
            <div class="section-body">
              <h3 class="group-head">{o.tiers ? 'Included in both' : 'Included'}</h3>
              <ul class="checks">{o.included.map((i) => <li>{i}</li>)}</ul>
            </div>
          )}
          {o.audit && <p class="service-note">{o.audit}</p>}

          {o.addons && (
            <div class="addons">
              <h3 class="h4">Optional add-ons, quoted separately</h3>
              <ul class="chips">{o.addons.map((a) => <li>{a}</li>)}</ul>
            </div>
          )}

          {o.scope?.map((line) => <p class="service-note">{line}</p>)}
          {o.note && <p class="price-movers">{o.note}</p>}
        </div>
      </div>
    </section>
  ))}

  <section class="section section-tint" id="process">
    <div class="wrap">
      <div class="section-head">
        <FallHeading text="How a website project runs" />
        <p class="lead">Five stages, with your approval at each one. A business website usually takes 2–3 weeks from approved content to launch.</p>
      </div>
      <Flow steps={website.process} />
    </div>
  </section>

  <DeliveryModels page="website" />

  <Faq faqs={website.faqs} heading="Website questions" intro="What business owners ask before they commit to a project." />

  <CtaStrip
    heading="Discuss your website with our team"
    body="Tell us about the business, its customers and any website you have today. We will recommend the right format and send a fixed-price proposal in writing."
    primary={proposal}
  />
</Base>
