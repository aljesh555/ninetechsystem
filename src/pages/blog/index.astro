---
/**
 * The blog index. The newest guide leads at full width; the rest follow as
 * cards. Each carries its own isometric artwork, so no stock photography is
 * needed and every guide looks like it belongs to this company.
 */
import Base from '../../layouts/Base.astro';
import BuildHero from '../../components/services/BuildHero.astro';
import CtaStrip from '../../components/services/CtaStrip.astro';
import Arrow from '../../components/services/Arrow.astro';
import { scene } from '../../lib/icons.js';
import { getPosts, readingTime, formatDate } from '../../lib/blog.js';
import { site } from '../../data/site.js';
import { breadcrumbList, abs, orgRef } from '../../lib/schema.js';

const path = '/blog';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path },
];
const posts = await getPosts();
const [featured, ...rest] = posts;
const categories = [...new Set(posts.map((p) => p.data.category))];

const facts = [
  { icon: 'sheet', value: `${posts.length} guides`, label: 'And more as the questions come in' },
  { icon: 'users', value: 'Written for buyers', label: 'Not for other developers' },
  { icon: 'search', value: 'Answer first', label: 'The short answer, then the detail' },
  { icon: 'chat', value: 'No sign-up', label: 'Nothing gated, no sales sequence' },
];

const schema = [
  {
    '@type': 'Blog',
    '@id': `${abs(path)}#blog`,
    name: `${site.name} guides`,
    description: 'Practical answers to the questions business owners in Nepal ask before they commission software.',
    url: abs(path),
    publisher: orgRef,
    blogPost: posts.map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      description: p.data.description,
      datePublished: p.data.date.toISOString().slice(0, 10),
      url: abs(`/blog/${p.id}`),
    })),
  },
  breadcrumbList(crumbs),
];
---

<Base
  title="Guides for Businesses in Nepal — Nine Technology"
  description="Practical answers to the questions business owners ask before they commission a website, software or automation: what things cost, what to check, what to avoid."
  path={path}
  schema={schema}
>
  <BuildHero
    crumbs={crumbs}
    kicker="Guides"
    h1="Answers to the questions we are asked"
    sceneName="guides"
    primary={{ label: 'Request a consultation', href: '/contact' }}
    secondary={{ label: 'See what we do', href: '/services' }}
    facts={facts}
  >
    Written for the person deciding, not for other developers. What things cost in Nepal, what to check before you sign, and what tends to go wrong.
  </BuildHero>

  {categories.length > 0 && (
    <section class="section section-tint">
      <div class="wrap">
        <p class="kicker">Topics covered</p>
        <ul class="chips" aria-label="Topics covered">
          {categories.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </section>
  )}

  {posts.length === 0 ? (
    <section class="section">
      <div class="wrap narrow"><p class="lead">The first guides are being written and will appear here shortly.</p></div>
    </section>
  ) : (
    <section class="section">
      <div class="wrap">
        <article class="post-featured reveal">
          <div class="post-art post-art-lg"><Fragment set:html={scene(featured.data.art)} /></div>
          <div class="post-featured-copy">
            <p class="post-meta">
              <span class="post-badge">{featured.data.featured ? 'Featured' : 'Latest'}</span>
              <time datetime={featured.data.date.toISOString().slice(0, 10)}>{formatDate(featured.data.date)}</time>
              <span aria-hidden="true">·</span>{featured.data.category}
              <span aria-hidden="true">·</span>{readingTime(featured.body)} min read
            </p>
            <h2><a class="post-link" href={`/blog/${featured.id}`}>{featured.data.title}</a></h2>
            <p class="post-excerpt">{featured.data.description}</p>
            <ul class="post-takeaways">
              {featured.data.takeaways.slice(0, 2).map((t) => <li>{t}</li>)}
            </ul>
            <span class="svc-view" aria-hidden="true">Read article <Arrow /></span>
          </div>
        </article>

        {rest.length > 0 && (
          <ol class="post-grid stagger reveal">
            {rest.map((p) => (
              <li class="post-card">
                <div class="post-art"><Fragment set:html={scene(p.data.art)} /></div>
                <p class="post-meta">
                  {p.data.category}<span aria-hidden="true">·</span>{readingTime(p.body)} min read
                </p>
                <h2><a class="post-link" href={`/blog/${p.id}`}>{p.data.title}</a></h2>
                <p class="post-excerpt">{p.data.description}</p>
                <span class="svc-view" aria-hidden="true">Read article <Arrow /></span>
              </li>
            ))}
          </ol>
        )}
      </div>
    </section>
  )}

  <CtaStrip
    heading="A question we have not covered?"
    body="Ask it directly. If the answer is useful to other businesses, it becomes the next guide."
    primary={{ label: 'Request a consultation', href: '/contact' }}
  />
</Base>
