---
import { site, nav } from '../data/site.js';
import fullLockup from '../../assets/brand/logo-full-navy.svg?raw';
import wordmark from '../../assets/brand/logo-wordmark-navy.svg?raw';

const { path } = Astro.props;
// A detail page such as /services/website still marks Services as current.
const current = (href) =>
  href === path ? 'page' : href !== '/' && path.startsWith(`${href}/`) ? 'true' : undefined;
---

<header class="header">
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label="Nine Technology — home">
      <span class="brand-full"><Fragment set:html={fullLockup} /></span>
      <span class="brand-wm"><Fragment set:html={wordmark} /></span>
    </a>

    <nav class="nav-desktop" aria-label="Main">
      {nav.map((item) => (
        <a href={item.href} aria-current={current(item.href)}>{item.label}</a>
      ))}
      <a class="btn btn-primary" href="/contact">Get a quote</a>
    </nav>

    {/* On phones the number and WhatsApp stay in the bar, never behind the menu. */}
    <div class="header-direct">
      <a class="header-tel" href={site.phoneHref} aria-label={`Call Nine Technology on ${site.phoneDisplay}`}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/>
        </svg>
        <span>{site.phoneDisplay}</span>
      </a>
      <a class="header-icon" href={site.whatsapp} aria-label="Message Nine Technology on WhatsApp">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="#1faf54" aria-hidden="true" focusable="false">
          <path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2zm0 2a8 8 0 1 1-4.1 14.9l-.3-.2-2.5.7.7-2.4-.2-.4A8 8 0 0 1 12 4zm-3.5 4c-.2 0-.5.1-.7.4-.3.3-.9.9-.9 2.1s.9 2.4 1.1 2.6c.1.2 1.8 2.8 4.4 3.8 2.2.9 2.6.7 3.1.6.5 0 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2l-.6-.4-1.7-.8c-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.1-.2 0-.4.1-.5l.4-.5.3-.5v-.5l-.7-1.7c-.2-.5-.4-.5-.6-.5h-.5z"/>
        </svg>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu" aria-label="Open menu" data-menu-toggle>
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
          <path d="M2 5h16M2 10h16M2 15h16"/>
        </svg>
      </button>
    </div>
  </div>

  <nav class="wrap nav-mobile" id="menu" aria-label="Menu">
    {nav.map((item) => (
      <a href={item.href} aria-current={current(item.href)}>{item.label}</a>
    ))}
    <a class="btn btn-primary" href="/contact">Get a quote</a>
  </nav>
</header>
