---
/** One service on the Grow, Automate and Support pages. */
import { priceLabel, contactHref } from '../../data/services.js';
const { s } = Astro.props;
---
<article class="service" id={s.id}>
  <div class="service-top">
    <h2 class="h3">{s.name}</h2>
    <p class="fact">{priceLabel(s.price, s.priceNote)}</p>
  </div>
  <p class="service-answer">{s.answer}</p>

  {(s.includes.length > 0 || s.excludes.length > 0) && (
    <div class="service-detail">
      {s.includes.length > 0 && (
        <div>
          <h3 class="h4">What you get</h3>
          <ul>{s.includes.map((i) => <li>{i}</li>)}</ul>
        </div>
      )}
      {s.excludes.length > 0 && (
        <div class="excl">
          <h3 class="h4">Not included</h3>
          <ul>{s.excludes.map((i) => <li>{i}</li>)}</ul>
        </div>
      )}
    </div>
  )}

  {s.note && <p class="service-note">{s.note}</p>}
  {s.priceMovers && <p class="price-movers">{s.priceMovers}</p>}
  <a class="btn btn-secondary" href={contactHref(s.cta.need)}>{s.cta.label}</a>
</article>
