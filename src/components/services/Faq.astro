---
/**
 * FAQ as a native <details> accordion: opens without JavaScript, keyboard
 * operable, and the answers stay in the page for search and AI crawlers.
 */
const { faqs, heading = 'Common questions', intro, tint = true } = Astro.props;
---
<section class={`section${tint ? ' section-tint' : ''}`} id="faq">
  <div class="wrap split">
    <div class="split-head">
      <h2>{heading}</h2>
      {intro && <p>{intro}</p>}
    </div>
    <div class="accordion faq-acc">
      {faqs.map((f, i) => (
        <details class="acc" open={i === 0}>
          <summary>
            <span class="acc-title">{f.q}</span>
            <svg class="acc-chev" width="14" height="9" viewBox="0 0 14 9" fill="none" aria-hidden="true" focusable="false">
              <path d="M1 1.5L7 7.5L13 1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
