---
/** A question answered yes or no: "Do you need an iOS app?" */
const { path, ask, hint, cost = path } = Astro.props;
---

<div class="q">
  <div class="q-text">
    <p class="q-ask">{ask}</p>
    {hint && <p class="q-hint">{hint}</p>}
  </div>
  <div class="q-ctl">
    <div class="seg" role="group" aria-label={ask}>
      <button type="button" data-path={path} data-v="false">No</button>
      <button type="button" data-path={path} data-v="true">Yes</button>
    </div>
    <p class="q-cost" data-cost={cost}></p>
  </div>
</div>
