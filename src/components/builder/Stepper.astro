---
/** A question answered with a number: "How many reels a month?" [-] 8 [+]. */
const { path, ask, hint, min = 0, max = 99, step = 1, cost = path, unit } = Astro.props;
---

<div class="q">
  <div class="q-text">
    <p class="q-ask">{ask}</p>
    {hint && <p class="q-hint">{hint}</p>}
  </div>
  <div class="q-ctl">
    <div class="stepper" data-stepper={path} data-min={min} data-max={max} data-step={step}>
      <button type="button" data-dec aria-label={`Fewer: ${ask}`}>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10" /></svg>
      </button>
      <output data-out aria-live="polite">0</output>
      <button type="button" data-inc aria-label={`More: ${ask}`}>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M8 3v10" /></svg>
      </button>
    </div>
    {unit && <span class="q-unit">{unit}</span>}
    <p class="q-cost" data-cost={cost}></p>
  </div>
</div>
